<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- The time zone follows the company: staff cannot change it in their preferences -->
    <record id="view_users_form_simple_modif_origin" model="ir.ui.view">
        <field name="name">res.users.preference.form.modif.origin</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form_simple_modif"/>
        <field name="arch" type="xml">
            <field name="tz" position="attributes">
                <attribute name="readonly">1</attribute>
            </field>
        </field>
    </record>
    <!-- Odoo 12 also made general_director_id read-only in the preferences (kderp_base view, not ported). -->
</odoo>
