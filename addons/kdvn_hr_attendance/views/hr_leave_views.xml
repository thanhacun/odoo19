<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- hr.leave.cover views -->
    <record id="hr_leave_cover_tree" model="ir.ui.view">
        <field name="name">hr.leave.cover.tree</field>
        <field name="model">hr.leave.cover</field>
        <field name="arch" type="xml">
            <list edit="0" create="0" decoration-success="state == 'waiting_fman'" decoration-info="state ==  'waiting_fhr'" decoration-warning="state == 'waiting_fman2'" decoration-danger="state == 'refuse'" decoration-muted="state == 'done'">
                <field name="employee_id" column_invisible="context.get('leave_single_mode')"/>
                <field name="name"/>
                <field name="department_id" string="Section|Project"/>
                <field name="date_from" string="From"/>
                <field name="date_from_period" string="Half"/>
                <field name="date_to" string="To"/>
                <field name="date_to_period" string="Half"/>
                <field name="number_of_days" string="Duration"/>
                <field name="state" string="State"/>
                <button name="action_submit" title="Submit" icon="fa-paper-plane" type="object" invisible="next_button_visible != 'submit'"/>
                <button name="action_approve" title="Approve" icon="fa-arrow-right text-success" type="object" invisible="next_button_visible != 'approve'"/>
                <button name="action_validate" title="Validate" icon="fa-check text-success" type="object" invisible="next_button_visible != 'validate'"/>
                <button name="action_need_director" title="Need GM" icon="fa-user-plus text-danger" type="object" groups="hr_attendance.group_hr_attendance_manager" invisible="state != 'waiting_fhr'"/>
                <button name="action_approve_man2" title="GM Approve" icon="fa-check text-success" type="object" groups="kdvn_hr_attendance.group_hr_attendance_gm" invisible="next_button_visible != 'approve2'"/>
                <button name="action_refuse" title="Refuse" type="object" icon="fa-hand-stop-o text-danger" invisible="not refuse_button_visible"/>
                <button name="action_revise" title="Revise" icon="fa-pencil text-success" type="object" groups="kdvn_hr_attendance.group_hr_attendance_menu_staff,hr_attendance.group_hr_attendance_manager,kdvn_hr_attendance.group_hr_attendance_section_manager" invisible="not revise_button_visible"/>
                <button name="action_sync_status" title="Sync Status" icon="fa-refresh text-danger" type="object" groups="hr_attendance.group_hr_attendance_user" invisible="status_sync"/>
                
                <field name="next_button_visible" column_invisible="1"/>
                <field name="refuse_button_visible" column_invisible="1"/>
                <field name="revise_button_visible" column_invisible="1"/>
                <field name="man2_approve" column_invisible="1"/>
                <field name="status_sync" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="hr_leave_cover_kanban" model="ir.ui.view">
        <field name="name">hr.leave.cover.kanban</field>
        <field name="model">hr.leave.cover</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" create="0" group_edit="0" group_create="0" default_group_by="employee_id">
                <field name="employee_id"/>
                <field name="name"/>
                <field name="dt_from"/>
                <field name="dt_to"/>
                <field name="date_from_period"/>
                <field name="date_to_period"/>
                <field name="number_of_days"/>
                <field name="next_button_visible"/>
                <field name="refuse_button_visible"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click container">
                            <div class="row no-gutters">
                                <div class="col-8">
                                    <t t-out="record.name.value"/>
                                    <t t-out="record.dt_from.value.slice(0,5) + ' ~ ' + record.dt_to.value.slice(0,5)"/>
                                    <t t-out="record.number_of_days.value"/>
                                </div>
                                <div class="col-4">
                                    <button name="action_submit" string="Submit" type="object" class="btn btn-sm btn-outline-dark" invisible="next_button_visible != 'submit'">
                                        <i title="Submit" class="fa fa-paper-plane"/></button>
                                    <button name="action_approve" string="Approve" type="object" class="btn btn-sm btn-outline-success" invisible="next_button_visible != 'approve'">
                                        <i title="Approve" class="fa fa-arrow-right"/></button>
                                    <button name="action_refuse" string="Refuse" type="object" class="btn btn-sm btn-outline-danger" invisible="not refuse_button_visible">
                                        <i title="Refuse" class="fa fa-hand-stop-o"/></button>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            
            </kanban>
        </field>
    </record>

    <record id="hr_leave_cover_form" model="ir.ui.view">
        <field name="name">hr.leave.cover.form</field>
        <field name="model">hr.leave.cover</field>
        <field name="arch" type="xml">
            <form create="0">
                <header>
                    <button name="action_submit" string="Submit" icon="fa-paper-plane" type="object" invisible="next_button_visible != 'submit'"/>
                    <button name="action_approve" string="Approve" icon="fa-arrow-right text-success" type="object" invisible="next_button_visible != 'approve'"/>
                    <button name="action_validate" string="Validate" icon="fa-check text-success" type="object" invisible="next_button_visible != 'validate'"/>

                    <button name="action_need_director" string="Need director" type="object" icon="fa-user-plus" class="btn-info" groups="hr_attendance.group_hr_attendance_manager" invisible="not need_director_button_visible"/>
                    <button name="action_approve_man2" string="GM Approve" icon="fa-check text-success" type="object" groups="kdvn_hr_attendance.group_hr_attendance_gm" invisible="next_button_visible != 'approve2'"/>

                    <button name="action_refuse" string="Refuse" type="object" icon="fa-hand-stop-o text-danger" invisible="not refuse_button_visible"/>
                    <!-- <button name="action_change_approve_manager" string="Change Manager" type="object"
                            icon="fa-exchange" attrs="{'invisible': [('state', '!=', 'draft')]}" /> -->
                    <button name="action_revise" string="Revise/Reset" type="object" icon="fa-pencil" groups="kdvn_hr_attendance.group_hr_attendance_menu_staff,hr_attendance.group_hr_attendance_manager,kdvn_hr_attendance.group_hr_attendance_section_manager" invisible="not revise_button_visible"/>
                    <button name="action_sync_status" string="Sync Status" icon="fa-refresh text-danger" type="object" groups="hr_attendance.group_hr_attendance_user" invisible="status_sync"/>

                    <field name="state" widget="statusbar" statusbar_visible="draft,waiting_fman,waiting_fhr,done"/>
                    <field name="revise_button_visible" invisible="1"/>
                    <field name="refuse_button_visible" invisible="1"/>
                    <field name="next_button_visible" invisible="1"/>
                    <field name="need_director_button_visible" invisible="1"/>
                    <field name="status_sync" invisible="1"/>
                </header>
                <sheet>
                    <group>
                        <group string="Cover Info.">
                            <field name="reason_id" placeholder="Please select a template" options="{'no_create': True, 'no_open': True, 'limit': 12}" widget="selection" context="{'employee_id': context.get('default_employee_id'), 'leave_cover_reason_id': reason_id}"/>
                            <field name="approve_manager_id" string="Approve manager" decoration-warning="approve_manager_id != False" invisible="not approve_manager_id"/>
                            <field name="refuse_comment" decoration-danger="refuse_comment != '' and state == 'refuse'" decoration-muted="refuse_comment != '' and state != 'refuse'" invisible="refuse_comment == '' or not refuse_comment"/>
                            <field name="view_user_ids" widget="many2many_tags"/>
                            <!-- <button name="button_quick_create" type="object" icon="fa-plus" /> -->
                        </group>
                        <group string="General Info.">
                            <field name="name"/>
                            <field name="employee_id" required="1" options="{'no_open': True}" readonly="employee_id"/>
                            <field name="department_id" string="Section|Project" options="{'no_open': True}"/>
                        </group>
                    </group>
                    <group string="Leaves Detail">
                        <field name="leave_request_ids" nolabel="1" mode="list,form" context="{'leave_reason_id': reason_id, 'default_employee_id': employee_id, 'at_id': context.get('at_id', False)}">
                            <list editable="bottom" decoration-danger="status_sync == False" decoration-success="status_sync == True">
                                <field name="sequence" widget="handle"/>
                                <field name="request_date_from" string="From"/>
                                <field name="request_date_from_pm" invisible="same_request_date and request_date_to_am"/>
                                <field name="request_date_to" string="To"/>
                                <field name="request_date_to_am" invisible="same_request_date and request_date_from_pm"/>
                                <field name="number_of_days" string="Duration" readonly="True" sum="Total"/>
                                <field name="holiday_status_id" string="Type" options="{'no_open': True}" context="{'employee_id': employee_id, 'request_date_from': request_date_from}"/>
                                <field name="substitute_for_date" string="Sub. for" invisible="not show_substitute_for_date"/>
                                <!-- <field name="substitute_for_at_id" attrs="{'invisible': [('show_substitute', '=', False)]}" string="Sub. for" help="Substitute for" /> -->
                                <field name="substitute_period" string="Sub. AM/PM" invisible="not show_substitute_for_date"/>
                                <field name="state" string="State" groups="hr_attendance.group_hr_attendance_user" invisible="status_sync"/>
                                <field name="request_date_from_period" string="Half" column_invisible="1"/>
                                <field name="request_date_to_period" string="Half" column_invisible="1"/>
                                <field name="employee_id" column_invisible="1"/>
                                <field name="state" column_invisible="1"/>
                                <field name="date_from" column_invisible="1"/>
                                <field name="date_to" column_invisible="1"/>
                                <field name="number_of_days" column_invisible="1"/>
                                <field name="same_request_date" column_invisible="1"/>
                                <field name="name" column_invisible="1"/>
                                <field name="show_substitute_for_date" column_invisible="1"/>
                                <field name="status_sync" column_invisible="1"/>
                                <field name="leave_cover_id" column_invisible="1"/>
                                <control>
                                    <create string="Add a leave"/>
                                </control>
                            </list>
                            <form>
                                <group>
                                    <field name="request_date_from" string="From"/>
                                    <field name="request_date_from_pm" invisible="same_request_date and request_date_to_am"/>
                                    <field name="request_date_to" string="To"/>
                                    <field name="request_date_to_am" invisible="same_request_date and request_date_from_pm"/>
                                    <field name="number_of_days" string="Duration" readonly="True"/>
                                    <field name="holiday_status_id" string="Type" options="{'no_open': True}"/>
                                    <field name="substitute_for_date" string="Sub. for" invisible="not show_substitute_for_date"/>
                                    <field name="substitute_period" string="Sub. AM/PM" invisible="not show_substitute_for_date"/>
                                    <field name="request_date_from_period" string="Half" invisible="1"/>
                                    <field name="request_date_to_period" string="Half" invisible="1"/>
                                    <field name="employee_id" invisible="1"/>
                                    <field name="state" invisible="1"/>
                                    <field name="date_from" invisible="1"/>
                                    <field name="date_to" invisible="1"/>
                                    <field name="number_of_days" invisible="1"/>
                                    <field name="same_request_date" invisible="1"/>
                                    <field name="name" invisible="1"/>
                                    <field name="show_substitute_for_date" invisible="1"/>
                                </group>
                            </form>
                            <kanban class="o_kanban_mobile" create="1">
                                <field name="employee_id"/>
                                <field name="date_from"/>
                                <field name="date_to"/>
                                <field name="name"/>
                                <field name="number_of_days"/>
                                <field name="holiday_status_id"/>
                                <templates>
                                    <t t-name="card">
                                        <div class="container">
                                            <div class="row">
                                                <div class="col-12">
                                                    <span class="badge badge-pill float-right"><t t-out="record.number_of_days.value"/> days</span>
                                                    <strong class="o_kanban_record_title"><t t-out="record.holiday_status_id.value"/>: </strong>
                                                    <span><t t-out="record.date_from.value.slice(0,5)"/></span> ~ 
                                                    <span><t t-out="record.date_to.value.slice(0,5)"/></span>
                                                    <!-- <button type="object" name="unlink"><i class="fa fa-trash" /></button> -->
                                                </div>
                                            </div>
                                        </div>
                                    </t>
                                </templates>
                            </kanban>
                        </field>
                    </group>
                    <group string="Summary" invisible="1">
                        <field name="dt_from" string="From"/>
                        <field name="date_from_period" string="(Half day)" nolabel="1"/>
                        <field name="dt_to" string="To"/>
                        <field name="date_to_period" string="(Half day)" nolabel="1"/>
                        <field name="number_of_days" string="Duration" class="oe_read_only"/>
                        <field name="date_from" options="{'format': 'DD/MM/YYYY'}" invisible="1"/>
                        <field name="date_to" options="{'format': 'DD/MM/YYYY'}" invisible="1"/>
                    </group>
                    <group string="Current Allocations" class="d-none d-lg-block">
                        <field name="allocation_summary" nolabel="1"/>
                    </group>

                </sheet>
                <footer>
                    <button name="save" string="Save" special="save" class="oe_highlight" invisible="context.get('is_readonly', False)"/>
                    <!-- <button name="action_submit" string="Submit" icon="fa-paper-plane" type="object" attrs="{'invisible': [('next_button_visible', '!=', 'submit')]}"/> -->
                    <button name="cancel" string="Discard" special="cancel"/>
                    <div class="text-danger">Note: Your request will be auto submitted!</div>
                </footer>
                <!-- <div class="oe_chatter" >
                    <field name="message_follower_ids" widget="mail_followers" />
                    <field name="message_ids" widget="mail_thread" />
                </div> -->
            </form>
        </field>
    </record>

    <record id="hr_leave_cover_filter" model="ir.ui.view">
        <field name="name">hr.leave.cover.filter</field>
        <field name="model">hr.leave.cover</field>
        <field name="arch" type="xml">
            <search string="Search for Leave">
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="dt_from" string="From"/>
                <field name="dt_to" string="To"/>
                <field name="number_of_days"/>
                <!-- <field name="special_leave" /> -->
                <!-- [X] TODO: hide My Leaves for GM/Director -->
                <!-- <filter string="My Leaves" name="my_leaves" domain="[('employee_id.user_id', '=', uid)]" 
                    groups="base.group_user,kdvn_hr_attendance.group_hr_attendance_section_admin"/> -->
                <!-- <separator /> -->
                <filter string="Staff Leaves" name="my_staff_leaves" domain="[('department_id.manager_id.user_id', '=', uid)]" groups="kdvn_hr_attendance.group_hr_attendance_section_manager"/>
                <filter string="Section Leaves" name="section" domain="[('employee_id.admin_manager_id.user_id', '=', uid)]" groups="kdvn_hr_attendance.group_hr_attendance_section_manager"/>
                
                <separator/>
                <filter domain="[('state','in',['waiting_fman2'])]" string="GM Approve" name="wait_for_gm" groups="kdvn_hr_attendance.group_hr_attendance_gm"/>
                <filter domain="[('state','in',['waiting_fhr'])]" string="HR Validate" name="validate" groups="hr_attendance.group_hr_attendance_user"/>
                <filter domain="[('state','in',['waiting_fman'])]" string="Manager Approve" name="approve" groups="kdvn_hr_attendance.group_hr_attendance_section_manager"/>
                <filter name="not_submit" string="Not submit yet" domain="[('state', 'in', ['draft', 'refuse'])]" groups="kdvn_hr_attendance.group_hr_attendance_menu_staff"/>

                <separator/>
                <filter string="Show AH" name="show_ah_leaves" context="{'show_ah': True}" groups="base.group_user"/>
                <filter name="special_leave" string="Special Leave" domain="[('special_leave', '=', True)]"/>
                <filter name="leave_on_sat" string="Leave On SAT" domain="[('leave_on_sat', '=', True)]"/>
                <filter name="not_in_sync" string="Status NOT sync" domain="[('status_sync', '=', False)]"/>

                <separator/>

                <group>
                    <filter name="group_department" string="Section" context="{'group_by': 'department_id'}"/>
                    <filter name="group_employee" string="Employee" context="{'group_by': 'employee_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- hr.leave views -->
    <!-- for KDVN -->
    <record id="hr_leave_view_form_kdvn" model="ir.ui.view">
        <field name="name">hr.leave.view.form.kdvn</field>
        <field name="model">hr.leave</field>
        <field name="priority">10</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="request_date_from" string="From"/>
                        <field name="request_date_from_pm" invisible="same_request_date and request_date_to_am"/>
                        <field name="request_date_to" string="To"/>
                        <field name="request_date_to_am" invisible="same_request_date and request_date_from_pm"/>
                        <field name="number_of_days" string="Duration" readonly="True"/>
                        <field name="holiday_status_id" string="Type" options="{'no_open': True}"/>
                        <field name="substitute_for_date" string="Sub. for" invisible="not show_substitute_for_date"/>
                        <field name="substitute_period" string="Sub. AM/PM" invisible="not show_substitute_for_date"/>
                        <field name="request_date_from_period" string="Half" invisible="1"/>
                        <field name="request_date_to_period" string="Half" invisible="1"/>
                        <field name="employee_id" invisible="1"/>
                        <field name="state" invisible="1"/>
                        <field name="date_from" invisible="1"/>
                        <field name="date_to" invisible="1"/>
                        <field name="number_of_days" invisible="1"/>
                        <field name="same_request_date" invisible="1"/>
                        <field name="name" invisible="1"/>
                        <field name="show_substitute_for_date" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    
    <!-- Not ported: Odoo 12 replaced the sheet of the core hr.leave form. Odoo 19 core views inherit it in several places,
         and nothing of ours uses it (the cover form embeds hr_leave_view_form_kdvn). -->

    <!-- Not ported: Odoo 12 replaced the whole core hr.leave kanban (kanban-box markup). Core 19 kanban stays. -->

    <record id="hr_leave_type_form" model="ir.ui.view">
        <field name="name">hr.leave.type.view.form</field>
        <field name="model">hr.leave.type</field>
        <field name="inherit_id" ref="hr_holidays.edit_holiday_status_form"/>
        <field name="arch" type="xml">
            <field name="time_type" position="after">
                <field name="is_ah"/>
                <field name="is_special"/>
                <field name="category"/>
            </field>
        </field>
    </record>

    <record id="hr_leave_cover_reason_tree" model="ir.ui.view">
        <field name="name">hr.leave.cover.reason.tree</field>
        <field name="model">hr.leave.cover.reason</field>
        <field name="arch" type="xml">
            <list string="Leave reasons" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="category"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="hr_leave_cover_reason_form" model="ir.ui.view">
        <field name="name">hr.leave.cover.reason.form</field>
        <field name="model">hr.leave.cover.reason</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="name"/>
                    <field name="code"/>
                    <field name="sequence"/>
                    <field name="category"/>
                    <field name="active"/>
                </group>
            </form>
        </field>
    </record>

    <!-- HR Leave Allocation Views -->
    <record id="hr_leave_allocation_view_form" model="ir.ui.view">
        <field name="name">hr.leave.allocation.view.form.inherit</field>
        <field name="model">hr.leave.allocation</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_allocation_view_form"/>
        <field name="arch" type="xml">
            <field name="name" position="replace">
                <field name="name"/>
            </field>
            <field name="number_of_days" position="replace">
                <field name="number_of_days" class="oe_inline" nolabel="1" readonly="type_request_unit == 'hour' or state not in ['draft', 'confirm', 'validate']" invisible="type_request_unit == 'hour'"/>
            </field>
            <!-- <field name="employee_id" position="after"> -->
                <!-- <field name="allow_to_use" attrs="{'readonly': [('state', 'not in', ('draft', 'confirm', 'validate'))], 
                    'invisible': ['!', ('holiday_status_id', '=', 'Special Leave')]}" /> -->
                    <!-- <field name="allow_to_use" attrs="{'readonly': [('state', 'not in', ('draft', 'confirm', 'validate'))]}" /> -->
            <!-- </field> -->
            <sheet position="inside">
                <group string="[Only apply for Yearly Special Leave]">
                    <field name="allow_to_use" readonly="state not in ['draft', 'confirm', 'validate']"/>
                    <!-- <div class="text-danger">Apply for Yearly Special Leaves only</div> -->
                </group>
                <group string="[Only apply for Special Leave]" invisible="leave_type_name != 'Special Leave'">
                    <field name="valid_from" required="leave_type_name == 'Special Leave'"/>
                    <field name="valid_to" required="leave_type_name == 'Special Leave'"/>
                </group>
                <group string="Taken Leaves Detail">
                    <field name="leave_ids" readonly="1">
                        <list editable="top" default_order="request_date_from, request_date_to">
                            <field name="name"/>
                            <field name="request_date_from" string="From"/>
                            <field name="request_date_from_pm"/>
                            <field name="request_date_to" string="To"/>
                            <field name="request_date_to_am"/>
                            <field name="holiday_status_id"/>
                            <field name="number_of_days" string="Duration" sum="Total"/>
                            <field name="state" column_invisible="1"/>
                        </list>
                    </field>
                </group>
                <group string="Other">
                    <field name="ot_last_update" string="OT Last Update" invisible="name not in ['OT Compensation', 'Last Year Leave']"/>
                </group>
                <field name="leave_type_name" invisible="1"/>
            </sheet>
        </field>
    </record>

    <record id="hr_leave_allocation_view_form_manager" model="ir.ui.view">
        <field name="name">hr.leave.allocation.view.form.manager</field>
        <field name="model">hr.leave.allocation</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_allocation_view_form_manager"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='holiday_status_id']" position="attributes">
                <attribute name="domain">[]</attribute>
            </xpath>
        </field>
    </record>

    <record id="hr_leave_allocation_filter" model="ir.ui.view">
        <field name="name">hr.allocation.filter</field>
        <field name="model">hr.leave.allocation</field>
        <field name="inherit_id" ref="hr_holidays.view_hr_leave_allocation_filter"/>
        <field name="arch" type="xml">
            <field name="accrual_plan_id" position="replace">
                <filter name="active_allocation" string="Active Allocation" domain="[('state', '=', 'validate'), ('employee_id', '=', False)]"/>
                <!-- <filter name="show_ah" string="Show AH" domain="['|', ('holiday_status_id.is_ah', '=', True), ('holiday_status_id.is_ah', '=', False)]" /> -->
                <filter name="no_show_ah" string="Hide AH" domain="[('holiday_status_id.is_ah', '=', False)]"/>
                <!-- <filter name="invalid_allocation" string="Hide invalid" domain="[('holiday_status_id.valid', '=', False)]" /> -->
                <filter name="valid_allocation" string="Valid Allocations" domain="[('holiday_status_id.valid', '=', True)]"/>
            </field>
            <filter name="refused_allocations" position="after">
                <separator/>
                <filter name="special_leave" string="Special Leave" domain="[('holiday_status_id.is_special', '=', True), ('leave_type_name', '=', 'Special Leave')]"/>
                <filter name="yearly_special_leave" string="Yearly Special Leave" domain="[('holiday_status_id.category', '=', 'special_leave')]"/>
            </filter>
            <filter name="message_needaction" position="attributes"><attribute name="invisible">1</attribute></filter>
            <filter name="my_team_leaves" position="attributes">
                <attribute name="string">Section Allocation</attribute>
                <attribute name="domain">[('employee_id.admin_manager_id.user_id', '=', uid)]</attribute>
            </filter>
            <filter name="activities_overdue" position="attributes"><attribute name="invisible">1</attribute></filter>
            <filter name="activities_today" position="attributes"><attribute name="invisible">1</attribute></filter>
            <filter name="activities_upcoming_all" position="attributes"><attribute name="invisible">1</attribute></filter>
        </field>
    </record>

    <record id="hr_leave_allocation_view_tree" model="ir.ui.view">
        <field name="name">hr.leave.allocation.view.tree</field>
        <field name="model">hr.leave.allocation</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_allocation_view_tree"/>
        <field name="arch" type="xml">
            <field name="duration_display" position="after">
                <field name="total_allowed"/>
                <field name="remaining_leaves"/>
                <field name="leaves_taken"/>
                <field name="leaves_taken_past"/>
            </field>
            <field name="state" position="after">
                <field name="validity_start"/>
                <field name="validity_stop"/>
                <!-- <field name="allow_to_use" attrs="{'invisible': ['!', ('name', '=', 'Special Leave')]}" /> -->
                <field name="allow_to_use"/>
            </field>
        </field>
    </record>

    <!-- leave allocation pivot -->
    <record id="hr_leave_allocation_pivot" model="ir.ui.view">
        <field name="name">hr.leave.allocation.pivot</field>
        <field name="model">hr.leave.allocation</field>
        <field name="arch" type="xml">
            <pivot string="Leave Allocation Summary">
                <field name="employee_id" type="row"/>
                <field name="name" type="col"/>
                <field name="number_of_days" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- OT allocation update summary -->
    <record id="hr_leave_allocation_ot_days_tracking_list" model="ir.ui.view">
        <field name="name">hr.leave.allocation.ot.days.tracking.list</field>
        <field name="model">hr.leave.allocation.ot.days.tracking</field>
        <field name="arch" type="xml">
            <list string="OT Compensation update summary">
                <field name="employee_id"/>
                <field name="allocation_id"/>
                <field name="leave_type_id"/>
                <field name="old_value_float"/>
                <field name="new_value_float"/>
                <field name="write_uid" string="Update user"/>
                <field name="write_date" string="Update date"/>
            </list>
        </field>
    </record>

    <!-- leave cover refuse -->
    <!-- Pivot, Graph -->
    <record id="leave_summary_pivot" model="ir.ui.view">
        <field name="name">hr.leave.summary.pivot</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.view_holiday_pivot"/>
        <field name="arch" type="xml">
            <pivot position="replace">
                <pivot>
                    <field name="employee_id" type="row"/>
                    <field name="request_date_from" type="col" interval="day"/>
                    <field name="number_of_days" type="measure"/>
                </pivot>
            </pivot>
        </field>
    </record>

    <record id="leave_allocation_summary_tree" model="ir.ui.view">
        <field name="name">hr.leave.allocation.report.tree</field>
        <field name="model">hr.leave.allocation.report</field>
        <field name="arch" type="xml">
            <list string="Leave Allocation">
                <field name="employee_id"/>
                <field name="name"/>
                <field name="holiday_status_id"/>
                <field name="number_of_days"/>
                <field name="validity_start"/>
                <field name="validity_stop"/>
