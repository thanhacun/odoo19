<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_holidays_public_list" model="ir.ui.view">
        <field name="name">hr.holidays.public.list</field>
        <field name="model">hr.holidays.public</field>
        <field name="arch" type="xml">
            <list string="Public Holidays">
                <field name="display_name"/>
                <field name="country_id"/>
            </list>
        </field>
    </record>

    <record id="view_holidays_public_form" model="ir.ui.view">
        <field name="name">hr.holidays.public.form</field>
        <field name="model">hr.holidays.public</field>
        <field name="arch" type="xml">
            <form string="Public Holidays">
                <sheet>
                    <group>
                        <field name="year"/>
                        <field name="country_id"/>
                    </group>
                    <group string="Public Holidays">
                        <field name="line_ids" nolabel="1" colspan="2">
                            <list string="Public Holidays" editable="top">
                                <field name="date"/>
                                <field name="name"/>
                                <field name="state_ids" widget="many2many_tags" domain="[('country_id', '=', parent.country_id)]"/>
                                <field name="is_company_day"/>
                                <field name="is_substitute"/>
                                <field name="variable_date"/>
                                <field name="resource_calendar_id"/>
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="open_holidays_public_view" model="ir.actions.act_window">
        <field name="name">Public Holidays</field>
        <field name="res_model">hr.holidays.public</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_hr_public_holidays" name="Public Holidays" parent="hr_holidays.menu_hr_holidays_root" sequence="20"/>
    <menuitem id="menu_holidays_public_view" action="open_holidays_public_view" parent="menu_hr_public_holidays" sequence="10"/>
</odoo>
