<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="list_hr_attendance_period_unlock" model="ir.ui.view">
        <field name="name">hr.attendance.period.unlock.list</field>
        <field name="model">hr.attendance.period.unlock</field>
        <field name="arch" type="xml">
            <list create="1" edit="0" decoration-muted="state == 'expired'">
                <field name="create_date" string="Date"/>
                <field name="user_id"/>
                <field name="employee_id" placeholder="All employees"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="reason"/>
                <field name="expires_at"/>
                <field name="state" widget="badge" decoration-success="state == 'active'" decoration-muted="state == 'expired'"/>
            </list>
        </field>
    </record>

    <record id="form_hr_attendance_period_unlock" model="ir.ui.view">
        <field name="name">hr.attendance.period.unlock.form</field>
        <field name="model">hr.attendance.period.unlock</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_lock_again" type="object" string="Lock again" invisible="state != 'active'" confirm="End this unlock now?"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="alert alert-warning" role="alert" invisible="id">
                        Attendance periods older than the lock months (Settings) are closed for payroll. Unlock only what must change:
                        the days lock again by themselves at the end time, and every unlocked day gets a note with your name and the reason.
                    </div>
                    <group>
                        <group>
                            <field name="employee_id" placeholder="All employees" readonly="id" options="{'no_create': True}"/>
                            <field name="date_from" readonly="id"/>
                            <field name="date_to" readonly="id"/>
                        </group>
                        <group>
                            <field name="reason" readonly="id" placeholder="Why must these days change? (required)"/>
                            <field name="expires_at" readonly="id"/>
                            <field name="user_id"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_hr_attendance_period_unlock" model="ir.actions.act_window">
        <field name="name">Period unlocks</field>
        <field name="res_model">hr.attendance.period.unlock</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_hr_attendance_period_unlock" name="Period unlocks" parent="menu_hr_attendance_settings_group" sequence="60"
              groups="hr_attendance.group_hr_attendance_user" action="action_hr_attendance_period_unlock"/>
</odoo>
