<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Employee form: attendance fields in the KDERP group of the Settings tab (kdvn_hr) -->
    <record id="hr_employee_view_form" model="ir.ui.view">
        <field name="name">hr.employee.form.kdvn.attendance</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/*[1]" position="before">
                <div class="alert alert-danger" role="status" invisible="not need_action">
                    <h4 class="alert-heading" role="alert">Need Hr Actions</h4>
                    <field name="need_action_explain"/>
                </div>
            </xpath>
            <xpath expr="//page[@name='hr_settings']//group[@name='kderp_hr']" position="inside">
                <field name="joining_date"/>
                <field name="official_working_date"/>
                <field name="ot_apply"/>
                <field name="remote_code"/>
                <field name="work_location" readonly="1"/>
            </xpath>
            <xpath expr="//page[@name='hr_settings']//group[@name='kderp_hr']" position="after">
                <group name="hr_leaves_balances" string="Leaves">
                    <field name="leaves_bal"/>
                    <field name="leaves_carry_forward_bal"/>
                    <field name="ot_compensation_leave_bal"/>
                    <field name="special_leaves_0"/>
                    <field name="special_leaves_1"/>
                    <field name="special_leaves_2"/>
                </group>
                <group name="need_hr_action" string="Need HR Action">
                    <field name="need_action"/>
                    <field name="need_action_explain"/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Department form: OT staff limits next to the type -->
    <record id="hr_department_form_view" model="ir.ui.view">
        <field name="name">hr.department.form.kdvn.attendance</field>
        <field name="model">hr.department</field>
        <field name="inherit_id" ref="kdvn_hr.inherited_hr_department_view_form_inherit_kderp_hr"/>
        <field name="arch" type="xml">
            <field name="type_id" position="after">
                <field name="area_id" readonly="1"/>
                <field name="section_ot_staff"/>
                <field name="area_ot_staff"/>
            </field>
        </field>
    </record>
    <!-- Not ported on purpose (Odoo 19 core does it): attendance status icon in the employee kanban, leave counters in the department kanban
         and the "Department Leaves" action. Odoo 12 replaced those core views/actions completely. -->
</odoo>
