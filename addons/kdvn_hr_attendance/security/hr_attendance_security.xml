<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Groups of kderp_hr_attendance. Odoo 12 renamed/extended core groups; in Odoo 19 core groups are only extended (implied ids). -->
    <record id="group_hr_attendance_menu_staff" model="res.groups">
        <field name="name">KDVN Staff</field>
        <field name="privilege_id" ref="hr_attendance.res_groups_privilege_attendances"/>
    </record>

    <record id="group_hr_attendance_section_admin" model="res.groups">
        <field name="name">Section Admin</field>
        <field name="privilege_id" ref="hr_attendance.res_groups_privilege_attendances"/>
    </record>

    <record id="group_hr_attendance_section_manager" model="res.groups">
        <field name="name">Section Manager</field>
        <field name="privilege_id" ref="hr_attendance.res_groups_privilege_attendances"/>
        <field name="implied_ids" eval="[(4, ref('group_hr_attendance_section_admin'))]"/>
    </record>

    <record id="group_hr_attendance_director" model="res.groups">
        <field name="name">Admin Director</field>
        <field name="privilege_id" ref="hr_attendance.res_groups_privilege_attendances"/>
    </record>

    <record id="group_hr_attendance_gm" model="res.groups">
        <field name="name">GM</field>
        <field name="privilege_id" ref="hr_attendance.res_groups_privilege_attendances"/>
    </record>

    <!-- as in Odoo 12: attendance HR admins are also time-off managers; attendance managers also KDERP HR admins -->
    <record id="hr_attendance.group_hr_attendance_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('hr_holidays.group_hr_holidays_manager'))]"/>
    </record>
    <record id="hr_attendance.group_hr_attendance_manager" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('hr_holidays.group_hr_holidays_manager')), (4, ref('kdvn_hr.group_kderp_hr_admin'))]"/>
    </record>
</odoo>
