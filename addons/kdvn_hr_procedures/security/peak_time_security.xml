<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="group_peak_time_functional_manager" model="res.groups">
            <field name="name">Peak Time: Functional Controller / HR Manager</field>
            <field name="privilege_id" ref="kdvn_e_approval.privilege_kderp_e_approval"/>
        </record>
        
        <record id="rule_kderp_project_peak_time_employee" model="ir.rule">
            <field name="name">Employee: Own Project Peak Time Only</field>
            <field name="model_id" ref="model_kderp_project_peak_time"/>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="domain_force">[('create_uid', '=', user.id)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="rule_kderp_project_peak_time_manager_isolation" model="ir.rule">
            <field name="name">Project Peak Time Managers</field>
            <field name="model_id" ref="model_kderp_project_peak_time"/>
            <field name="groups" eval="[
                (4, ref('kdvn_hr_attendance.group_hr_attendance_section_manager')),
                (4, ref('kdvn_hr_attendance.group_hr_attendance_gm'))
            ]"/> 
            <field name="domain_force">[('review_ids', 'in', user.review_ids.ids)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_kderp_project_peak_time_auditor" model="ir.rule">
            <field name="name">Auditor: Read-Only All Records</field>
            <!-- We apply this to the mixin model if using a shared rule, or replicate per concrete model -->
            <field name="model_id" ref="model_kderp_project_peak_time"/> 
            <field name="groups" eval="[(4, ref('kdvn_e_approval.group_e_approval_global_auditor'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field> <!-- 🚀 Unlocks all records in the database -->
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/> <!-- 🔒 No Editing -->
            <field name="perm_create" eval="False"/> <!-- 🔒 No Creation -->
            <field name="perm_unlink" eval="False"/> <!-- 🔒 No Deletion -->
        </record>

         <record id="rule_peak_time_functional_manager_all_access" model="ir.rule">
            <field name="name">Peak Time Manager: View and Edit All Records</field>
            <field name="model_id" ref="model_kderp_project_peak_time"/>
            <field name="groups" eval="[(4, ref('group_peak_time_functional_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field> 
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

    </data>
</odoo>
