<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Both ship INACTIVE (noupdate: an upgrade never switches them back). Activate by hand once Settings > Remote Server Connection
         is filled and tested, and n8n no longer posts to this database (or while comparing: both together are harmless). -->
    <data noupdate="1">
        <record id="cron_remote_pull_full" model="ir.cron">
            <field name="name">Remote server: pull jobs, budgets and customers (full)</field>
            <field name="model_id" ref="model_kderp_remote_pull"/>
            <field name="state">code</field>
            <field name="code">model.cron_full()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="False"/>
        </record>
        <record id="cron_remote_pull_customers" model="ir.cron">
            <field name="name">Remote server: pull changed customers (every 5 minutes)</field>
            <field name="model_id" ref="model_kderp_remote_pull"/>
            <field name="state">code</field>
            <field name="code">model.cron_customers()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="False"/>
        </record>
    </data>
</odoo>
