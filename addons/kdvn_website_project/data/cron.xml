<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Daily 02:00 (as the n8n workflow did). Skips quietly when no remote server is set up. -->
    <record id="ir_cron_kdvn_pull_projects" model="ir.cron">
        <field name="name">Website Projects: pull finished big jobs from KDERP</field>
        <field name="model_id" ref="model_kdvn_website_project"/>
        <field name="state">code</field>
        <field name="code">model._cron_kdvn_pull_from_kderp()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 19:00:00')"/>
    </record>
</odoo>
