<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Website projects -->
    <record id="kdvn_website_project_view_list" model="ir.ui.view">
        <field name="name">kdvn.website.project.list</field>
        <field name="model">kdvn.website.project</field>
        <field name="arch" type="xml">
            <list string="Website Projects">
                <field name="sequence" widget="handle"/>
                <field name="image_128" widget="image" options="{'size': [48, 48]}" string="Photo"/>
                <field name="name"/>
                <field name="year"/>
                <field name="area"/>
                <field name="project_type"/>
                <field name="category_id"/>
                <field name="tag_ids" widget="many2many_tags"/>
                <field name="job_ids" widget="many2many_tags" optional="hide"/>
                <field name="is_published" widget="boolean_toggle" string="Published"/>
            </list>
        </field>
    </record>

    <record id="kdvn_website_project_view_form" model="ir.ui.view">
        <field name="name">kdvn.website.project.form</field>
        <field name="model">kdvn.website.project</field>
        <field name="arch" type="xml">
            <form string="Website Project">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="image_1920" widget="image" class="oe_avatar" options="{'preview_image': 'image_256'}"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Pocari Sweat Factory"/></h1>
                    </div>
                    <group>
                        <group string="Shown on the website">
                            <field name="is_published" widget="boolean_toggle" string="Published"/>
                            <field name="year"/>
                            <field name="area" placeholder="e.g. Hanoi, Vietnam"/>
                            <field name="project_type"/>
                            <field name="category_id" options="{'no_create': True}"/>
                            <field name="tag_ids" widget="many2many_tags" options="{'no_create_edit': True}"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group string="KDERP">
                            <field name="job_ids" widget="many2many_tags" options="{'no_create': True}"
                                   placeholder="Job number or name"/>
                            <div colspan="2" class="text-muted small">
                                The year is filled from the jobs' completion date (or start date) and can be changed.
                                Linked jobs are kept in Odoo even when KDERP stops sending them.
                            </div>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description" name="description">
                            <field name="description" placeholder="Not shown on the website yet."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="kdvn_website_project_view_kanban" model="ir.ui.view">
        <field name="name">kdvn.website.project.kanban</field>
        <field name="model">kdvn.website.project</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="id"/>
                <templates>
                    <t t-name="card" class="flex-row">
                        <aside class="o_kanban_aside_full">
                            <field name="image_128" widget="image" options="{'img_class': 'object-fit-cover'}"/>
                        </aside>
                        <main class="ps-2">
                            <field name="name" class="fw-bold"/>
                            <div><field name="year"/> · <field name="category_id"/></div>
                            <field name="tag_ids" widget="many2many_tags"/>
                            <field name="is_published" widget="boolean_toggle"/>
                        </main>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="kdvn_website_project_view_search" model="ir.ui.view">
        <field name="name">kdvn.website.project.search</field>
        <field name="model">kdvn.website.project</field>
        <field name="arch" type="xml">
            <search string="Website Projects">
                <field name="name"/>
                <field name="job_ids"/>
                <field name="category_id"/>
                <field name="tag_ids"/>
                <field name="year"/>
                <filter name="filter_published" string="Published" domain="[('is_published', '=', True)]"/>
                <filter name="filter_unpublished" string="Not Published" domain="[('is_published', '=', False)]"/>
                <filter name="filter_no_photo" string="No Photo" domain="[('image_128', '=', False)]"/>
                <separator/>
                <filter name="filter_archived" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_year" string="Year" context="{'group_by': 'year'}"/>
                    <filter name="group_category" string="Category" context="{'group_by': 'category_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="kdvn_website_project_action" model="ir.actions.act_window">
        <field name="name">Projects</field>
        <field name="res_model">kdvn.website.project</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add a project for the website</p>
            <p>Or select jobs in KDERP Jobs and use Actions &gt; Create Website Project.
               Published projects appear on /prominent-projects.</p>
        </field>
    </record>

    <!-- Categories and work scopes -->
    <record id="kdvn_website_project_category_view_list" model="ir.ui.view">
        <field name="name">kdvn.website.project.category.list</field>
        <field name="model">kdvn.website.project.category</field>
        <field name="arch" type="xml">
            <list string="Project Categories" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="slug"/>
                <field name="project_count" string="Projects"/>
            </list>
        </field>
    </record>
    <record id="kdvn_website_project_category_action" model="ir.actions.act_window">
        <field name="name">Project Categories</field>
        <field name="res_model">kdvn.website.project.category</field>
        <field name="view_mode">list</field>
    </record>

    <record id="kdvn_website_project_tag_view_list" model="ir.ui.view">
        <field name="name">kdvn.website.project.tag.list</field>
        <field name="model">kdvn.website.project.tag</field>
        <field name="arch" type="xml">
            <list string="Work Scopes" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
            </list>
        </field>
    </record>
    <record id="kdvn_website_project_tag_action" model="ir.actions.act_window">
        <field name="name">Project Work Scopes</field>
        <field name="res_model">kdvn.website.project.tag</field>
        <field name="view_mode">list</field>
    </record>

    <!-- Website > Site > Content > Projects; Website > Configuration > Project Categories / Work Scopes -->
    <menuitem id="kdvn_website_project_menu" name="Projects" parent="website.menu_content"
              action="kdvn_website_project_action" sequence="40"/>
    <menuitem id="kdvn_website_project_category_menu" name="Project Categories"
              parent="website.menu_website_global_configuration" action="kdvn_website_project_category_action" sequence="60"/>
    <menuitem id="kdvn_website_project_tag_menu" name="Project Work Scopes"
              parent="website.menu_website_global_configuration" action="kdvn_website_project_tag_action" sequence="61"/>
</odoo>
