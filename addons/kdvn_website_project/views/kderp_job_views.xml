<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- KDERP Jobs: show linked website projects; Actions > Create Website Project -->
    <record id="view_kderp_job_lookup_form_website" model="ir.ui.view">
        <field name="name">kderp.job.lookup.form.website.project</field>
        <field name="model">kderp.job.lookup</field>
        <field name="inherit_id" ref="kdvn_remote_sync.view_kderp_job_lookup_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="website_project_ids" widget="many2many_tags" readonly="1"/>
            </xpath>
        </field>
    </record>

    <record id="action_kdvn_create_website_project" model="ir.actions.server">
        <field name="name">Create Website Project</field>
        <field name="model_id" ref="kdvn_remote_sync.model_kderp_job_lookup"/>
        <field name="binding_model_id" ref="kdvn_remote_sync.model_kderp_job_lookup"/>
        <field name="binding_view_types">list,form</field>
        <field name="group_ids" eval="[(4, ref('website.group_website_designer'))]"/>
        <field name="state">code</field>
        <field name="code">action = records.action_kdvn_create_website_project()</field>
    </record>
</odoo>
