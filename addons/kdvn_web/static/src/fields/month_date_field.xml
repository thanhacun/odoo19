<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="kdvn_web.MonthDateField">
        <t t-if="props.readonly">
            <span t-esc="formattedDate"/>
        </t>
        <t t-else="">
            <div class="d-flex align-items-center gap-2">
                <input type="month" class="o_input o-kdvn-MonthDate" style="min-width: 11rem;" t-att-id="props.id" t-att-value="monthValue" t-on-change="onChange"/>
                <span t-if="value" class="text-muted small" t-esc="formattedDate"/>
            </div>
        </t>
    </t>
</templates>
