<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- ================= 📂 Entertainment and Expense CATEGORY SUB-MENUS  ================= -->    
        <menuitem id="menu_cat_req_entertainment" name="Entertainment &amp; Expense" parent="kdvn_e_approval.menu_sub_my_requests" sequence="10"/>
        <menuitem id="menu_cat_rev_entertainment" name="Entertainment &amp; Expense" parent="kdvn_e_approval.menu_sub_my_reviews" sequence="10"/>


        <!-- ================= 🎬 ACTIONS: ENTERTAINMENT EXPENSE PROCEDURE ================= -->
        <record id="action_my_entertainment_requests" model="ir.actions.act_window">
            <field name="name">My Requests - Entertainment</field>
            <field name="res_model">entertainment.request</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('create_uid', '=', uid)]</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">Create your first Pre-Auth Entertainment Fee Request!</p>
            </field>
        </record>

        <record id="action_manager_approval_queue" model="ir.actions.act_window">
            <field name="name">Waiting My Approval - Entertainment</field>
            <field name="res_model">entertainment.request</field>
            <field name="view_mode">list,form,kanban</field>
            <field name="domain">[]</field>
            <field name="context">{'search_default_filter_to_approve': 1}</field>
        </record>

        <record id="action_all_entertainment_requests" model="ir.actions.act_window">
            <field name="name">All Company Requests - Entertainment</field>
            <field name="res_model">entertainment.request</field>
            <field name="view_mode">list,form,kanban</field>
        </record>

        <!-- All Entertainment Requests Admin -->
        <menuitem id="menu_action_all_requests" name="Master Audit Tracking (Entertainment)" parent="kdvn_e_approval.menu_sub_cat_master_audit" action="action_all_entertainment_requests" sequence="900" 
            groups="kdvn_e_approval.group_e_approval_admin,kdvn_e_approval.group_e_approval_global_auditor,kdvn_entertainment_procedures.group_entertainment_request_functional_manager"/>

        <!-- ================= 🔏 LEAF NODE BINDINGS: ENTERTAINMENT ================= -->
        <!-- Help > guide page (opened in the web client so debug mode stays; needs kderp_knowledge) -->
        <record id="action_guide_entertainment_srv" model="ir.actions.server">
            <field name="name">Entertainment Fee Guide</field>
            <field name="model_id" ref="base.model_res_users"/>
            <field name="state">code</field>
            <field name="code">action = env['document.page'].kderp_action_open_guide('e-approval/entertainment-fee')</field>
        </record>
        <menuitem id="menu_help_guide_entertainment" name="Entertainment Fee" parent="kdvn_e_approval.menu_sub_help"
                  action="action_guide_entertainment_srv" sequence="20"/>

        <menuitem id="menu_action_my_requests" name="Entertainment Requests" parent="menu_cat_req_entertainment" action="action_my_entertainment_requests" sequence="10"/>
        <menuitem id="menu_action_manager_queue" name="Entertainment Reviews" parent="menu_cat_rev_entertainment" action="action_manager_approval_queue" sequence="10"/>
    </data>
</odoo>