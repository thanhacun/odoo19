<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_entertainment_advance_wizard_form" model="ir.ui.view">
        <field name="name">entertainment.advance.wizard.form</field>
        <field name="model">entertainment.advance.wizard</field>
        <field name="arch" type="xml">
            <form string="Create advance request">
                <field name="request_id" invisible="1"/>
                <field name="live" invisible="1"/>
                <div class="alert alert-info" role="alert">
                    The advance request is created on the remote server as a draft. The <b>input user</b> you choose sees it there and continues the process.
                    The list shows the job's site admins first, then the people who entered advance requests for this job and for this applicant before
                    (read from the remote server). The first person who can process it is suggested (&#9733;); you can choose another one.
                </div>
                <field name="hint" readonly="1" nolabel="1" invisible="not hint"/>
                <group>
                    <field name="admin_line_id" options="{'no_create': True, 'no_open': True}"/>
                </group>
                <field name="line_ids" nolabel="1" readonly="1">
                    <list decoration-muted="not ok" decoration-bf="suggested">
                        <field name="suggested" column_invisible="1"/>
                        <field name="mark"/>
                        <field name="name"/>
                        <field name="roles"/>
                        <field name="location_name"/>
                        <field name="why"/>
                        <field name="is_admin" string="Job admin"/>
                        <field name="ok"/>
                        <field name="reason"/>
                    </list>
                </field>
                <field name="how" readonly="1" nolabel="1"/>
                <field name="preview" readonly="1" nolabel="1"/>
                <footer>
                    <button name="action_create" type="object" class="btn btn-primary"
                            string="Create on remote server" invisible="not live"/>
                    <button name="action_create" type="object" class="btn btn-default"
                            string="Try (dry run, writes nothing)" invisible="live"/>
                    <button string="Close" class="btn btn-default" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
