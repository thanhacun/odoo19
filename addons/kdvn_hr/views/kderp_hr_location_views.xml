<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_kderp_hr_location_code_tree" model="ir.ui.view">
        <field name="name">kderp.employee.location.code.list</field>
        <field name="model">kderp.employee.location.code</field>
        <field name="arch" type="xml">
            <list string="HR Location" editable="top">
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="view_kderp_hr_employee_location" model="ir.ui.view">
        <field name="name">kderp.hr.employee.location.list</field>
        <field name="model">kderp.hr.employee.location</field>
        <field name="arch" type="xml">
            <list string="HR Location" editable="top">
                <field name="date"/>
                <field name="location_id"/>
                <field name="employee_id"/>
            </list>
        </field>
    </record>

    <record id="action_kderp_view_hr_location_code" model="ir.actions.act_window">
        <field name="name">Location</field>
        <field name="res_model">kderp.employee.location.code</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_kderp_view_hr_employee_location" model="ir.actions.act_window">
        <field name="name">Employee Locations</field>
        <field name="res_model">kderp.hr.employee.location</field>
        <field name="view_mode">list</field>
    </record>

    <record id="action_kderp_hr_department_type" model="ir.actions.act_window">
        <field name="name">Department Types</field>
        <field name="res_model">hr.department.type</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
