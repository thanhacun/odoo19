<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="group_safety_tool_admin" model="res.groups">
            <field name="name">Safety Tool: Admin (store keeper)</field>
            <field name="privilege_id" ref="kdvn_e_approval.privilege_kderp_e_approval"/>
            <field name="comment">Keeps the safety tool catalogue and stock ledger, hands tools over, purchases when short of stock, edits the special case rules. Sees all safety tool requests.</field>
        </record>
        <record id="group_safety_tool_manager" model="res.groups">
            <field name="name">Safety Tool: Safety Manager (approver)</field>
            <field name="privilege_id" ref="kdvn_e_approval.privilege_kderp_e_approval"/>
            <field name="comment">Reviewers of the last approval step of a safety tool request. Add the Safety Manager here.</field>
        </record>
    </data>
</odoo>
