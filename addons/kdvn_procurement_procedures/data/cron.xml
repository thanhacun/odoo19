<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_safety_tool_receipt_reminder" model="ir.cron">
            <field name="name">Safety Tool: remind applicants to confirm the receipt</field>
            <field name="model_id" ref="model_safety_tool_request"/>
            <field name="state">code</field>
            <field name="code">model.cron_remind_receipt()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
