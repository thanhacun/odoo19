<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_safety_tool_import_wizard_form" model="ir.ui.view">
        <field name="name">safety.tool.import.wizard.form</field>
        <field name="model">safety.tool.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import the Safety Tool Control Sheet">
                <field name="state" invisible="1"/>
                <field name="batch_id" invisible="1"/>
                <group invisible="state != 'upload'">
                    <p class="text-muted" colspan="2">
                        Upload the latest "Safety Tool Control Sheet" (.xlsx). Nothing is written until you press Import.
                        Rows already imported are skipped, so a newer file only adds what is new.
                    </p>
                    <field name="file" filename="filename"/>
                    <field name="filename" invisible="1"/>
                    <field name="import_pictures"/>
                </group>
                <group invisible="state == 'upload'">
                    <group>
                        <field name="report_no"/>
                        <field name="report_date"/>
                    </group>
                    <group>
                        <field name="as_of_date" readonly="state == 'done'"/>
                    </group>
                </group>
                <group invisible="not summary">
                    <field name="summary" nolabel="1" colspan="2" readonly="1"/>
                </group>
                <field name="line_ids" invisible="state != 'preview'">
                    <list editable="bottom" decoration-danger="action == 'map' and not item_id"
                          decoration-muted="action == 'skip'" decoration-warning="has_gap">
                        <field name="sequence" invisible="1"/>
                        <field name="block_json" invisible="1"/>
                        <field name="has_gap" invisible="1"/>
                        <field name="excel_no" readonly="1"/>
                        <field name="excel_name" readonly="1"/>
                        <field name="size_text" readonly="1"/>
                        <field name="action"/>
                        <field name="item_id" options="{'no_create': True}"
                               readonly="action == 'skip'"/>
                        <field name="size_id" options="{'no_create': True}" domain="[('item_id', '=', item_id)]"
                               readonly="action == 'skip'"/>
                        <field name="has_picture" string="Picture"/>
                        <field name="n_new"/>
                        <field name="ledger_qty"/>
                        <field name="expected"/>
                        <field name="excel_qty"/>
                        <field name="diff"/>
                    </list>
                </field>
                <footer>
                    <button name="action_read" string="Read the file" type="object" class="btn-primary"
                            invisible="state != 'upload'"/>
                    <button name="action_import" string="Import" type="object" class="btn-primary"
                            confirm="Post the stock moves and the history requests now?"
                            invisible="state != 'preview'"/>
                    <button name="action_refresh" string="Refresh the preview" type="object"
                            invisible="state != 'preview'"/>
                    <button name="action_back" string="Another file" type="object"
                            invisible="state != 'preview'"/>
                    <button name="action_open_batch" string="Open the import" type="object" class="btn-primary"
                            invisible="state != 'done'"/>
                    <button string="Close" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_safety_tool_import_batch_tree" model="ir.ui.view">
        <field name="name">safety.tool.import.batch.list</field>
        <field name="model">safety.tool.import.batch</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'undone'">
                <field name="date"/>
                <field name="file_name"/>
                <field name="report_no"/>
                <field name="as_of_date"/>
                <field name="user_id"/>
                <field name="n_moves"/>
                <field name="n_requests"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_safety_tool_import_batch_form" model="ir.ui.view">
        <field name="name">safety.tool.import.batch.form</field>
        <field name="model">safety.tool.import.batch</field>
        <field name="arch" type="xml">
            <form string="Excel import" create="false" edit="false">
                <header>
                    <button name="action_undo" string="Undo this import" type="object" class="btn-warning"
                            confirm="Delete the stock moves and the history requests made by this import?"
                            invisible="state != 'done'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="file_name"/>
                            <field name="report_no"/>
                            <field name="as_of_date"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="user_id"/>
                            <field name="n_requests"/>
                            <field name="n_moves"/>
                        </group>
                    </group>
                    <group><field name="note" nolabel="1" colspan="2"/></group>
                    <notebook>
                        <page string="Requests">
                            <field name="request_ids">
                                <list><field name="state" invisible="1"/><field name="name"/><field name="employee_id"/>
                                    <field name="date_input"/><field name="import_project_text"/></list>
                            </field>
                        </page>
                        <page string="Stock moves">
                            <field name="move_ids">
                                <list><field name="date"/><field name="item_id"/><field name="size_id"/>
                                    <field name="qty_in"/><field name="qty_out"/><field name="source"/><field name="note"/></list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_safety_tool_import_alias_tree" model="ir.ui.view">
        <field name="name">safety.tool.import.alias.list</field>
        <field name="model">safety.tool.import.alias</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="excel_name"/>
                <field name="size_text"/>
                <field name="item_id"/>
                <field name="size_id" domain="[('item_id', '=', item_id)]"/>
                <field name="key" readonly="1"/>
            </list>
        </field>
    </record>

    <record id="action_safety_tool_import_wizard" model="ir.actions.act_window">
        <field name="name">Import the Control Sheet (Excel)</field>
        <field name="res_model">safety.tool.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    <record id="action_safety_tool_import_batches" model="ir.actions.act_window">
        <field name="name">Excel Imports</field>
        <field name="res_model">safety.tool.import.batch</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_safety_tool_import_aliases" model="ir.actions.act_window">
        <field name="name">Excel Item Mapping</field>
        <field name="res_model">safety.tool.import.alias</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem id="menu_safety_tool_import" name="Import the Control Sheet (Excel)" parent="menu_safety_tool_store"
              action="action_safety_tool_import_wizard" sequence="50"/>
    <menuitem id="menu_safety_tool_import_batches" name="Excel Imports" parent="menu_safety_tool_store"
              action="action_safety_tool_import_batches" sequence="60"/>
    <menuitem id="menu_safety_tool_import_aliases" name="Excel Item Mapping" parent="menu_safety_tool_store"
              action="action_safety_tool_import_aliases" sequence="70"/>
</odoo>
