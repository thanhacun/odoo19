<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_safety_tool_report_wizard_form" model="ir.ui.view">
        <field name="name">safety.tool.report.wizard.form</field>
        <field name="model">safety.tool.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Safety Tool Control Sheet">
                <group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group>
                        <field name="item_ids" widget="many2many_tags" options="{'no_create': True}"/>
                    </group>
                </group>
                <group invisible="not file">
                    <field name="filename" invisible="1"/>
                    <field name="file" filename="filename" readonly="1"/>
                </group>
                <footer>
                    <button name="action_generate" string="Create the Excel file" type="object" class="btn-primary"/>
                    <button string="Close" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_safety_tool_report_wizard" model="ir.actions.act_window">
        <field name="name">Control Sheet (Excel report)</field>
        <field name="res_model">safety.tool.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    <menuitem id="menu_safety_tool_report" name="Control Sheet (Excel report)" parent="menu_safety_tool_store"
              action="action_safety_tool_report_wizard" sequence="40"/>
</odoo>
