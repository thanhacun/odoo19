<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- One privilege per group: a privilege is drawn as a dropdown (No / group) under the category, so the
             groups sit in one visible section and are ticked independently. Groups without a privilege only show in debug mode. -->
        <record id="module_category_kderp_e_approval" model="ir.module.category">
            <field name="name">KDERP E-Approval Workspace</field>
            <field name="description">Security access levels for the corporate paperless workflow application portal.</field>
            <field name="sequence">20</field>
        </record>

        <!-- Define a unique security master override group role -->
        <record id="privilege_e_approval_admin" model="res.groups.privilege">
            <field name="name">Administrator</field>
            <field name="category_id" ref="module_category_kderp_e_approval"/>
        </record>
        <record id="group_e_approval_admin" model="res.groups">
            <field name="name">E-Approval: Administrator</field>
            <field name="privilege_id" ref="privilege_e_approval_admin"/>
            <field name="comment">Members can view/edit ALL requests across ALL modules.</field>
            <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
        </record>

        <record id="privilege_e_approval_global_auditor" model="res.groups.privilege">
            <field name="name">Read-Only Auditor</field>
            <field name="category_id" ref="module_category_kderp_e_approval"/>
        </record>
        <record id="group_e_approval_global_auditor" model="res.groups">
            <field name="name">E-Approval: Read-Only Auditor</field>
            <field name="privilege_id" ref="privilege_e_approval_global_auditor"/>
            <field name="comment">Members can view ALL requests across ALL modules but cannot modify or change states.</field>
        </record>
    </data>
</odoo>
