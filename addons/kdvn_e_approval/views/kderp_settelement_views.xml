<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_kderp_payment_settlement_form" model="ir.ui.view">
            <field name="name">kderp.payment.settlement.form</field>
            <field name="model">kderp.payment.settlement</field>
            <field name="arch" type="xml">
                <form string="Financial Payment Settlement Form">
                    <header>
                        <!-- 🚀 THE POST AND CLEAR BUTTON: Only visible to Accountants/GA in Draft state -->
                        <button name="action_post_and_clear_payment" 
                                string="💳 Post Payment &amp; Sync Analytics" 
                                type="object" 
                                class="oe_highlight" 
                                attrs="{'invisible': [('state', '!=', 'draft')]}"
                                groups="account.group_account_user"/>
                                
                        <field name="state" widget="statusbar" statusbar_visible="draft,paid"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="name"/></h1>
                        </div>
                        <group string="Cross-System Origin Parameters">
                            <group>
                                <field name="source_document_ref"/>
                                <field name="applicant_id" options="{'no_open': True}"/>
                            </group>
                            <group>
                                <field name="date_settlement"/>
                                <field name="payment_method"/>
                            </group>
                        </group>
                        <group string="Financial Reconciliation Matrix">
                            <group>
                                <field name="approved_budget" widget="monetary"/>
                                <field name="actual_invoice_amount" widget="monetary"/>
                            </group>
                            <group>
                                <field name="variance_amount" widget="monetary"/>
                                <field name="hr_expense_sheet_id" attrs="{'invisible': [('hr_expense_sheet_id', '=', False)]}"/>
                            </group>
                        </group>
                        <group string="Legal Compliance Digital Assets">
                            <field name="invoice_attachment_ids" widget="many2many_binary" string="Upload Vendor Invoices / Receipts"/>
                        </group>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

    </data>
</odoo>
