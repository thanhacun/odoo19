<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Odoo 19 settings page "E-Approval" (Odoo 12 injected these boxes into the remote sync settings form). Same fields, same stored values. -->
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.form.kdvn.e.approval</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="60"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="E-Approval" string="E-Approval" name="kdvn_e_approval" groups="base.group_system">
                    <block title="Approval links (n8n)" name="kdvn_e_approval_links">
                        <setting id="kdvn_e_approval_analytic" string="Central Accounting Webhook Link"
                                 help="Destination URL for streaming analytic lines to the central finance server when a settlement closes.">
                            <field name="n8n_analytic_webhook_url" placeholder="http://192.168.1..."/>
                        </setting>
                        <setting id="kdvn_e_approval_email_path" string="n8n Email Webhook Path"
                                 help="The webhook path in the n8n workflow that processes approve / reject links from e-mails.">
                            <field name="e_approval_email_webhook_path" placeholder="/webhook/v1/email-action"/>
                        </setting>
                        <setting id="kdvn_e_approval_decision_in_odoo" string="Approve/Reject pages in Odoo"
                                 help="Approve / reject links open pages served by Odoo (/ea/...) and n8n is not used for them. Links already sent through n8n keep working while n8n runs.">
                            <field name="e_approval_decision_in_odoo"/>
                        </setting>
                        <setting id="kdvn_e_approval_short_path" string="n8n Short Link Path"
                                 help="Webhook path for short approve / reject links (for example ea). Leave empty to keep the long links.">
                            <field name="e_approval_short_link_path" placeholder="ea"/>
                        </setting>
                        <setting id="kdvn_e_approval_secret" string="E-Approval Secret Key"
                                 help="Signs the approval links sent to approvers. The saved key is never shown again; type a new one only to change it (links already sent stop working).">
                            <!-- the saved key is never sent to the browser: a badge says whether one is saved -->
                            <field name="e_approval_secret_key_saved" invisible="1"/>
                            <div class="mb-2">
                                <span class="badge text-bg-success" invisible="not e_approval_secret_key_saved"><i class="fa fa-check" title="Saved"/> Saved</span>
                                <span class="badge text-bg-warning" invisible="e_approval_secret_key_saved">Not set yet</span>
                            </div>
                            <field name="e_approval_secret_key" widget="password" placeholder="New secret key" autocomplete="new-password"/>
                        </setting>
                    </block>
                    <block title="Interface" name="kdvn_e_approval_interface">
                        <setting id="kdvn_e_approval_ribbon" string="Workflow Progress Ribbon Style"
                                 help="How the review steps are drawn in the header of a request.">
                            <field name="e_approval_ribbon_style"/>
                        </setting>
                    </block>
                    <block title="Notifications" name="kdvn_e_approval_notify">
                        <setting id="kdvn_e_approval_notify_email" string="Global E-mail Notifications" help="Allow the system to send approval alerts by e-mail.">
                            <field name="global_notify_email"/>
                        </setting>
                        <setting id="kdvn_e_approval_notify_talk" string="Global Nextcloud Talk Alerts" help="Allow the system to send real-time approval notes through Nextcloud Talk.">
                            <field name="global_notify_talk"/>
                        </setting>
                    </block>
                    <block title="Nextcloud Talk connection" name="kdvn_e_approval_talk" invisible="not global_notify_talk">
                        <setting id="kdvn_e_approval_nc_url" string="Nextcloud Server URL">
                            <field name="nc_base_url" placeholder="https://kinden.com.vn"/>
                        </setting>
                        <setting id="kdvn_e_approval_nc_user" string="Bot Account Login Username">
                            <field name="nc_bot_username"/>
                        </setting>
                        <setting id="kdvn_e_approval_nc_pass" string="Bot Application Password">
                            <field name="nc_bot_password_saved" invisible="1"/>
                            <div class="mb-2">
                                <span class="badge text-bg-success" invisible="not nc_bot_password_saved"><i class="fa fa-check" title="Saved"/> Saved</span>
                                <span class="badge text-bg-warning" invisible="nc_bot_password_saved">Not set yet</span>
                            </div>
                            <field name="nc_bot_password" widget="password" placeholder="New password" autocomplete="new-password"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
