<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_kderp_notification_wizard_form" model="ir.ui.view">
        <field name="name">kderp.notification.wizard.form</field>
        <field name="model">kderp.notification.wizard</field>
        <field name="arch" type="xml">
            <form string="System Notification">
                <!-- Large, clean typographic display area -->
                <div class="alert alert-info" role="alert" style="margin-bottom: 0; padding: 15px; background-color: #f4fbfd; border-color: #bce5f1; color: #31708f;">
                    <i class="fa fa-info-circle fa-2x pull-left" style="margin-right: 10px; margin-top: -2px; color: #00a09d;"></i>
                    <div style="margin-left: 40px; font-size: 13px; line-height: 18px; white-space: pre-wrap;">
                        <field name="message" readonly="1" nolabel="1"/>
                    </div>
                </div>
                
                <!-- Fields loaded invisibly to control view attributes -->
                <field name="show_cancel" invisible="1"/>
                
                <footer>
                    <button string="OK" name="action_ok" type="object" class="btn btn-primary" style="font-weight: bold; min-width: 80px;"/>
                    <button string="Cancel" class="btn btn-default" special="cancel" attrs="{'invisible': [('show_cancel', '=', False)]}"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
