<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Approve / Reject pages behind the e-mail and Talk links (controllers/main.py: /ea/<code>).
         Plain HTML, no Odoo layout, works without JavaScript. Palette: done #28a745, current #7C7BAD,
         rejected #dc3545, muted #adb5bd, line #dee2e6. -->
    <template id="decision_page">
        <t t-set="accent" t-value="{'confirm': '#7C7BAD', 'reject': '#dc3545', 'approved': '#28a745', 'rejected': '#dc3545'}.get(state, '#adb5bd')"/>
        <html lang="en">
            <head>
                <meta charset="UTF-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
                <meta name="robots" content="noindex, nofollow"/>
                <title>E-Approval</title>
                <style>
                    body { margin:0; padding:24px 16px; background:#f4f5f7; color:#212529;
                           font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif; }
                    .card { max-width:420px; margin:24px auto; background:#fff; border:1px solid #dee2e6;
                            border-radius:6px; border-top:4px solid #adb5bd; padding:20px 22px; }
                    .brand { font-size:11px; letter-spacing:.06em; text-transform:uppercase; color:#6c757d; }
                    h1 { font-size:19px; margin:6px 0 14px; }
                    .ref { font-size:16px; font-weight:600; }
                    .muted { color:#6c757d; font-size:13px; margin-top:2px; }
                    .details { margin:12px 0 16px; padding:10px 12px; background:#f8f9fa; border-radius:4px;
                               font-size:14px; line-height:1.5; color:#495057; }
                    .lbl { display:block; font-size:13px; font-weight:600; margin-bottom:4px; }
                    textarea { width:100%; box-sizing:border-box; border:1px solid #dee2e6; border-radius:4px;
                               padding:8px; font:inherit; font-size:14px; margin-bottom:6px; }
                    .err { color:#dc3545; font-size:13px; margin-bottom:8px; }
                    button { width:100%; padding:12px; border:0; border-radius:4px; color:#fff; font-size:15px;
                             font-weight:600; cursor:pointer; }
                    .result { text-align:center; margin-top:14px; }
                    .big { font-size:44px; margin-bottom:6px; }
                    .quote { margin-top:12px; padding:8px 12px; border-left:3px solid #dc3545; background:#f8f9fa;
                             text-align:left; font-size:13px; color:#495057; word-break:break-word; }
                </style>
            </head>
            <body>
                <div class="card" t-attf-style="border-top-color:#{accent}">
                    <div class="brand">Kinden Vietnam · E-Approval</div>
                    <t t-if="state != 'error' and ref">
                        <div class="ref" style="margin-top:6px" t-out="ref"/>
                        <div class="muted"><t t-out="title"/><t t-if="title and applicant"> · </t><t t-out="applicant"/></div>
                        <div class="muted" t-if="step" t-out="step"/>
                    </t>

                    <t t-if="state in ('confirm', 'reject')">
                        <h1 t-if="state == 'confirm'" style="margin-top:12px">Approve this request?</h1>
                        <h1 t-else="" style="margin-top:12px">Reject this request?</h1>
                        <div class="details" t-if="details" t-out="details"/>
                        <form method="post" t-attf-action="/ea/#{code}">
                            <t t-if="state == 'confirm' and comment_required">
                                <label for="cmt" class="lbl">Comment <span style="color:#dc3545">(required)</span></label>
                                <textarea id="cmt" name="comment" rows="3" required="required" placeholder="Why do you approve this request?"/>
                            </t>
                            <t t-if="state == 'reject'">
                                <label for="cmt" class="lbl">Reason <span style="color:#dc3545">(required)</span></label>
                                <textarea id="cmt" name="comment" rows="4" required="required" placeholder="Why do you reject this request? The applicant will see it."/>
                            </t>
                            <div class="err" t-if="error" t-out="error"/>
                            <button type="submit" t-attf-style="background:#{'#28a745' if state == 'confirm' else '#dc3545'}">
                                <t t-if="state == 'confirm'">Approve</t><t t-else="">Reject</t>
                            </button>
                        </form>
                    </t>

                    <div class="result" t-if="state == 'approved'">
                        <div class="big">✅</div><h1>Approved</h1>
                        <div class="muted">Thank you. Your approval was recorded in Odoo.</div>
                    </div>
                    <div class="result" t-if="state == 'rejected'">
                        <div class="big">❌</div><h1>Rejected</h1>
                        <div class="muted">Your rejection was recorded in Odoo and the applicant has been informed.</div>
                        <div class="quote" t-if="comment"><b>Your reason:</b> <t t-out="comment"/></div>
                    </div>
                    <div class="result" t-if="state == 'already'">
                        <div class="big">ℹ️</div><h1>Already decided</h1>
                        <div class="muted">This step was already
                            <t t-out="{'approved': 'approved', 'rejected': 'rejected'}.get(current_status, 'decided')"/><t t-if="done_by"> by <t t-out="done_by"/></t>, so nothing was changed.</div>
                    </div>
                    <div class="result" t-if="state == 'error'">
                        <div class="big">⚠️</div><h1>Not done</h1>
                        <div class="muted" t-out="message"/>
                    </div>
                </div>
            </body>
        </html>
    </template>
</odoo>
