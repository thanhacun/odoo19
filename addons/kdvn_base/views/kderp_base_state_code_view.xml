<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="kderp_base_code_view_form" model="ir.ui.view">
        <field name="name">kderp.base.code.form</field>
        <field name="model">kderp.base.code</field>
        <field name="arch" type="xml">
            <form string="Base Code">
                <group>
                    <group>
                        <field name="sequence"/>
                        <field name="code"/>
                        <field name="name"/>
                        <field name="model_id"/>
                    </group>
                    <group>
                        <field name="type_code"/>
                        <field name="default_code"/>
                        <field name="color"/>
                        <field name="active"/>
                    </group>
                </group>
            </form>
        </field>
    </record>

    <record id="kderp_base_code_view_tree" model="ir.ui.view">
        <field name="name">kderp.base.code.list</field>
        <field name="model">kderp.base.code</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence"/>
                <field name="code"/>
                <field name="name"/>
                <field name="model_id" readonly="1"/>
                <field name="type_code"/>
                <field name="default_code"/>
                <field name="color"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="action_kderp_base_code_view" model="ir.actions.act_window">
        <field name="name">Code List</field>
        <field name="res_model">kderp.base.code</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="kderp_base_state_view_form" model="ir.ui.view">
        <field name="name">kderp.base.state.form</field>
        <field name="model">kderp.base.state</field>
        <field name="arch" type="xml">
            <form string="State">
                <group>
                    <group>
                        <field name="sequence"/>
                        <field name="code"/>
                        <field name="name"/>
                        <field name="model_id" readonly="1"/>
                        <field name="group_id"/>
                        <field name="group_editable_id"/>
                        <field name="previous_id"/>
                        <field name="next_id"/>
                    </group>
                    <group>
                        <field name="condition"/>
                        <field name="ignore"/>
                        <field name="finalstate"/>
                        <field name="button_label"/>
                        <field name="button_icon"/>
                        <field name="button_class"/>
                        <field name="default_code"/>
                        <field name="color"/>
                        <field name="active"/>
                    </group>
                </group>
            </form>
        </field>
    </record>

    <record id="kderp_base_state_view_tree" model="ir.ui.view">
        <field name="name">kderp.base.state.list</field>
        <field name="model">kderp.base.state</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence"/>
                <field name="code"/>
                <field name="name"/>
                <field name="model_id" readonly="1"/>
                <field name="previous_id"/>
                <field name="group_id"/>
                <field name="finalstate"/>
                <field name="default_code"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="action_kderp_base_state_view" model="ir.actions.act_window">
        <field name="name">State List</field>
        <field name="res_model">kderp.base.state</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_kderp_config" name="KDERP" parent="base.menu_custom" sequence="800" groups="base.group_system"/>
    <menuitem id="menu_kderp_base_code" action="action_kderp_base_code_view" parent="menu_kderp_config" sequence="5"/>
    <menuitem id="menu_kderp_base_state" action="action_kderp_base_state_view" parent="menu_kderp_config" sequence="10"/>
</odoo>
