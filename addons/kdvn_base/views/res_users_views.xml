<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Odoo 12 kderp_base: the user's location in the preferences, read-only (an administrator sets it) -->
    <record id="view_users_form_simple_modif_location" model="ir.ui.view">
        <field name="name">res.users.preferences.form.location</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form_simple_modif"/>
        <field name="arch" type="xml">
            <field name="tz" position="after">
                <field name="location_user_id" readonly="1"/>
            </field>
        </field>
    </record>
</odoo>
