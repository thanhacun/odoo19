#. module: kdvn_website
#: model_terms:ir.ui.view,arch_db:kdvn_website.company_history_page
msgid "From Japan’s engineering heritage to Vietnam’s industrial development"
msgstr "Từ di sản kỹ thuật Nhật Bản đến sự phát triển công nghiệp Việt Nam"

#. module: kdvn_website
#: model_terms:ir.ui.view,arch_db:kdvn_website.company_history_page
msgid "<strong>KINDEN CORPORATION</strong> was established in Japan in <strong>1944</strong> and has since developed extensive engineering expertise worldwide. Building on this heritage, Kinden Vietnam has developed long-term engineering capabilities and experience in Vietnam."
msgstr "<strong>KINDEN CORPORATION</strong> được thành lập tại Nhật Bản vào năm <strong>1944</strong> và từ đó đã phát triển chuyên môn kỹ thuật sâu rộng trên toàn thế giới. Kế thừa di sản đó, Kinden Việt Nam đã xây dựng năng lực và kinh nghiệm kỹ thuật lâu dài tại Việt Nam."

#. module: kdvn_website
#: model_terms:ir.ui.view,arch_db:kdvn_website.company_history_page
msgid "The First President Norishige Satake"
msgstr "Chủ tịch đầu tiên Norishige Satake"

#. module: kdvn_website
#: model_terms:ir.ui.view,arch_db:kdvn_website.company_history_page
msgid "80+ Years of Engineering Heritage"
msgstr "Hơn 80 năm di sản kỹ thuật"

#. module: kdvn_website
#: model_terms:ir.ui.view,arch_db:kdvn_website.company_history_page
msgid "KINDEN CORPORATION was established in Japan in 1944 and has since grown into one of Japan’s leading integrated facility engineering companies, with a global track record across electrical, mechanical and communication systems."
msgstr "KINDEN CORPORATION được thành lập tại Nhật Bản năm 1944 và đã phát triển thành một trong những công ty kỹ thuật cơ điện tổng hợp hàng đầu Nhật Bản, với thành tích toàn cầu trong các lĩnh vực hệ thống điện, cơ khí và truyền thông."

#. module: kdvn_website
#: model_terms:ir.ui.view,arch_db:kdvn_website.company_history_page
msgid "Explore KINDEN CORPORATION History"
msgstr "Tìm hiểu lịch sử KINDEN CORPORATION"

