<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Settings > Companies: Website Profile tab -->
    <record id="kdvn_company_view_form" model="ir.ui.view">
        <field name="name">res.company.form.kdvn</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <page name="general_info" position="after">
                <page string="Website Profile" name="kdvn_website_profile">
                    <group>
                        <group string="Company profile">
                            <field name="kdvn_founding_date"/>
                            <field name="kdvn_capital" placeholder="USD 1,210,000.00"/>
                            <field name="kdvn_employee_count"/>
                            <field name="kdvn_employee_count_date"/>
                        </group>
                        <group string="Head office (the company address above)">
                            <field name="kdvn_head_office_name" placeholder="Hanoi Head Office"/>
                            <field name="kdvn_head_office_fax"/>
                            <field name="kdvn_head_office_latitude"/>
                            <field name="kdvn_head_office_longitude"/>
                            <field name="kdvn_head_office_map_url" widget="url"/>
                            <div colspan="2" class="text-muted small">
                                The head office is always shown first on the website (footer, company profile, Office Location page).
                                Other offices: contacts of this company marked "Website Office" — see Website &gt; Site &gt; Content &gt; Offices.
                            </div>
                        </group>
                    </group>
                </page>
            </page>
        </field>
    </record>

    <!-- Contacts: Website tab -->
    <record id="kdvn_partner_view_form" model="ir.ui.view">
        <field name="name">res.partner.form.kdvn</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <page name="internal_notes" position="after">
                <page string="Website" name="kdvn_website" groups="website.group_website_designer">
                    <group>
                        <group>
                            <field name="kdvn_is_office"/>
                            <field name="kdvn_office_name" invisible="not kdvn_is_office"/>
                            <field name="kdvn_office_main" invisible="not kdvn_is_office"/>
                            <field name="kdvn_office_sequence" invisible="not kdvn_is_office"/>
                        </group>
                        <group>
                            <field name="kdvn_fax" invisible="not kdvn_is_office"/>
                            <field name="kdvn_map_url" invisible="not kdvn_is_office" widget="url"/>
                            <field name="partner_latitude" string="Latitude" invisible="not kdvn_is_office"/>
                            <field name="partner_longitude" string="Longitude" invisible="not kdvn_is_office"/>
                        </group>
                    </group>
                </page>
            </page>
        </field>
    </record>

    <!-- Website > Site > Content > Offices -->
    <record id="kdvn_office_view_list" model="ir.ui.view">
        <field name="name">res.partner.list.kdvn.office</field>
        <field name="model">res.partner</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <list decoration-bf="kdvn_is_head_office">
                <field name="kdvn_office_sequence" widget="handle"/>
                <field name="kdvn_is_head_office" column_invisible="1"/>
                <field name="kdvn_office_name"/>
                <field name="street"/>
                <field name="street2"/>
                <field name="city"/>
                <field name="phone"/>
                <field name="kdvn_office_main" invisible="kdvn_is_head_office"/>
                <field name="kdvn_is_head_office" string="Head Office" widget="boolean_toggle" readonly="1"/>
            </list>
        </field>
    </record>

    <record id="kdvn_office_view_form" model="ir.ui.view">
        <field name="name">res.partner.form.kdvn.office</field>
        <field name="model">res.partner</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="alert alert-info" role="status" invisible="not kdvn_is_head_office">
                        Head office = the company address. Changes here also change the company (Settings &gt; Companies).
                        It is always shown first on the website and always as a main office.
                    </div>
                    <div class="oe_title">
                        <h1><field name="kdvn_office_name" placeholder="e.g. Hanoi Head Office" required="1"/></h1>
                    </div>
                    <group>
                        <group string="Address">
                            <field name="parent_id" string="Company" readonly="1" invisible="kdvn_is_head_office"/>
                            <field name="street" placeholder="15F, CMC Tower, Duy Tan Street"/>
                            <field name="street2" placeholder="Cau Giay Ward"/>
                            <field name="city" placeholder="Ha Noi"/>
                            <field name="country_id"/>
                        </group>
                        <group string="Contact">
                            <field name="phone"/>
                            <field name="kdvn_fax"/>
                            <field name="email"/>
                            <field name="kdvn_map_url" widget="url"/>
                        </group>
                        <group string="Map position">
                            <div colspan="2" class="text-muted small">
                                Exact pin on the map. In Google Maps, right-click the building and click the coordinates to copy them (e.g. 21.0301, 105.7826).
                            </div>
                            <field name="partner_latitude" string="Latitude"/>
                            <field name="partner_longitude" string="Longitude"/>
                        </group>
                        <group string="Website" invisible="kdvn_is_head_office">
                            <field name="kdvn_office_main"/>
                            <field name="kdvn_office_sequence"/>
                            <field name="kdvn_is_office" invisible="1"/>
                            <field name="type" invisible="1"/>
                            <field name="name" invisible="1"/>
                            <field name="kdvn_is_head_office" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="kdvn_office_action" model="ir.actions.act_window">
        <field name="name">Offices</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="domain">['|', ('kdvn_is_office', '=', True), ('kdvn_company_ids', '!=', False)]</field>
        <field name="context">{'kdvn_office_form': True, 'default_kdvn_is_office': True, 'default_type': 'other'}</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('kdvn_office_view_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('kdvn_office_view_form')})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add the company's offices</p>
            <p>Offices are shown in the website footer (main offices), the company profile and the Office Locations page.</p>
        </field>
    </record>

    <menuitem id="kdvn_office_menu"
              name="Offices"
              parent="website.menu_content"
              action="kdvn_office_action"
              sequence="91"
              groups="website.group_website_designer"/>
</odoo>
