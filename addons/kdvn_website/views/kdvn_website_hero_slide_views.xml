<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="kdvn_website_hero_slide_view_list" model="ir.ui.view">
        <field name="name">kdvn.website.hero.slide.list</field>
        <field name="model">kdvn.website.hero.slide</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="image" widget="image" options="{'size': [96, 54]}"/>
                <field name="name"/>
                <field name="link_url"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="kdvn_website_hero_slide_view_form" model="ir.ui.view">
        <field name="name">kdvn.website.hero.slide.form</field>
        <field name="model">kdvn.website.hero.slide</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="image" widget="image" class="oe_avatar" options="{'size': [320, 0]}"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Title of the slide"/></h1>
                    </div>
                    <group>
                        <field name="link_url" placeholder="/company-profile"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="kdvn_website_hero_slide_view_search" model="ir.ui.view">
        <field name="name">kdvn.website.hero.slide.search</field>
        <field name="model">kdvn.website.hero.slide</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="kdvn_website_hero_slide_action" model="ir.actions.act_window">
        <field name="name">Hero Slides</field>
        <field name="res_model">kdvn.website.hero.slide</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Slides of the homepage slideshow</p>
            <p>Drag the rows to change the order. The first slide shows first.</p>
        </field>
    </record>

    <menuitem id="kdvn_website_hero_slide_menu"
              name="Hero Slides"
              parent="website.menu_content"
              action="kdvn_website_hero_slide_action"
              sequence="89"
              groups="website.group_website_designer"/>

    <record id="kdvn_hero_res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.kdvn.hero</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='website_info_settings']" position="inside">
                <setting id="kdvn_hero_interval_setting" string="Hero Slides" help="How many seconds each homepage slide stays before the next one.">
                    <field name="kdvn_hero_interval"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
