<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inquiries received with the website inquiry form (/contactus) -->
    <record id="kdvn_website_inquiry_view_list" model="ir.ui.view">
        <field name="name">kdvn.website.inquiry.list</field>
        <field name="model">kdvn.website.inquiry</field>
        <field name="arch" type="xml">
            <list decoration-bf="state == 'new'">
                <field name="create_date" string="Received"/>
                <field name="contact_name"/>
                <field name="company_name"/>
                <field name="email"/>
                <field name="phone" optional="show"/>
                <field name="inquiry_type_id"/>
                <field name="lang" optional="hide"/>
                <field name="state" widget="badge" decoration-info="state == 'new'" decoration-success="state == 'done'"/>
            </list>
        </field>
    </record>

    <record id="kdvn_website_inquiry_view_form" model="ir.ui.view">
        <field name="name">kdvn.website.inquiry.form</field>
        <field name="model">kdvn.website.inquiry</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_set_done" type="object" string="Mark as Handled" class="btn-primary" invisible="state != 'new'"/>
                    <button name="action_set_new" type="object" string="Reopen" invisible="state != 'done'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="contact_name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="company_name" readonly="1"/>
                            <field name="email" widget="email" readonly="1"/>
                            <field name="phone" widget="phone" readonly="1"/>
                        </group>
                        <group>
                            <field name="inquiry_type_id" readonly="1"/>
                            <field name="create_date" string="Received"/>
                            <field name="lang"/>
                            <field name="website_id" groups="website.group_multi_website"/>
                        </group>
                    </group>
                    <field name="message" readonly="1"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="kdvn_website_inquiry_view_search" model="ir.ui.view">
        <field name="name">kdvn.website.inquiry.search</field>
        <field name="model">kdvn.website.inquiry</field>
        <field name="arch" type="xml">
            <search>
                <field name="contact_name"/>
                <field name="company_name"/>
                <field name="email"/>
                <field name="message"/>
                <filter name="filter_new" string="New" domain="[('state', '=', 'new')]"/>
                <filter name="filter_done" string="Handled" domain="[('state', '=', 'done')]"/>
                <group>
                    <filter name="group_type" string="Inquiry Type" context="{'group_by': 'inquiry_type_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="kdvn_website_inquiry_action" model="ir.actions.act_window">
        <field name="name">Inquiries</field>
        <field name="res_model">kdvn.website.inquiry</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filter_new': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No inquiries yet</p>
            <p>Messages sent with the website inquiry form (/contactus) are listed here.</p>
        </field>
    </record>

    <menuitem id="kdvn_website_inquiry_menu"
              name="Inquiries"
              parent="website.menu_website_configuration"
              action="kdvn_website_inquiry_action"
              groups="website.group_website_designer"
              sequence="20"/>

    <!-- Options of the 'Inquiry type' list -->
    <record id="kdvn_website_inquiry_type_view_list" model="ir.ui.view">
        <field name="name">kdvn.website.inquiry.type.list</field>
        <field name="model">kdvn.website.inquiry.type</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="kdvn_website_inquiry_type_action" model="ir.actions.act_window">
        <field name="name">Inquiry Types</field>
        <field name="res_model">kdvn.website.inquiry.type</field>
        <field name="view_mode">list</field>
        <field name="context">{'active_test': False}</field>
    </record>

    <menuitem id="kdvn_website_inquiry_type_menu"
              name="Inquiry Types"
              parent="website.menu_website_global_configuration"
              action="kdvn_website_inquiry_type_action"
              groups="website.group_website_designer"
              sequence="60"/>

    <!-- Settings > Website: who receives the inquiries -->
    <record id="kdvn_res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.kdvn.inquiry</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='website_info_settings']" position="inside">
                <setting id="kdvn_inquiry_email_setting" string="Inquiry Form" help="Who receives the messages sent with the website inquiry form (comma separated). Empty: the company email.">
                    <field name="kdvn_inquiry_email" placeholder="info@kinden.com.vn"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
