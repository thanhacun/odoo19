<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Colour theme (Light / Dark / System): applied before first paint so a dark page never flashes white.
         The choice is kept in localStorage by static/src/js/theme_switch.js. No choice = light. -->
    <template id="kdvn_theme_boot" inherit_id="website.layout" name="KDVN colour theme boot">
        <xpath expr="//head" position="inside">
            <script>
                try {
                    var t = localStorage.getItem("kdvn_theme");
                    if (t === "dark" || t === "system") {
                        document.documentElement.setAttribute("data-kdvn-theme", t);
                    }
                } catch (e) {}
            </script>
        </xpath>
    </template>
</odoo>
