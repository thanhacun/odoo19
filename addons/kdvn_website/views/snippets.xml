<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Website builder: "Blocks" panel > Intro > "KDVN Hero Slider" -->
    <template id="kdvn_snippet_registration" inherit_id="website.snippets" name="KDVN Snippets">
        <xpath expr="//snippets[@id='snippet_structure']" position="inside">
            <t t-snippet="kdvn_website.s_kdvn_hero" string="KDVN Hero Slider" group="intro"
               t-thumbnail="/kdvn_website/static/src/img/content/home-hero-1.jpg">
                <keywords>KDVN hero slider carousel slideshow banner home</keywords>
            </t>
        </xpath>
    </template>

    <!--
        Hero slider (Figma: frames/home-desktop|tablet|mobile.png).
        Desktop/tablet: text column 615px (arrows top right, "View detail" + title at the bottom),
        photo fills the rest, 900px high. Mobile: arrows, button, title, then the photo.

        Builder: the classes s_carousel_wrapper / s_carousel / carousel-item give Odoo's
        carousel tools (add, remove, reorder slides). Arrows and indicators sit once,
        outside the slides (like Odoo's "Carousel Intro"); the indicators are hidden
        but needed by the builder. Each slide: photo (click > Replace), link, title.
    -->
    <template id="s_kdvn_hero" name="KDVN Hero Slider">
        <section class="s_carousel_wrapper s_kdvn_hero p-0" data-snippet="s_kdvn_hero" data-name="KDVN Hero Slider">
            <t t-set="uniq" t-value="datetime.datetime.now().microsecond"/>
            <div t-attf-id="kdvnHero{{uniq}}" class="s_carousel s_carousel_default carousel slide kdvn-hero"
                 data-bs-ride="true" data-bs-interval="10000">
                <div class="carousel-inner">
                    <div class="carousel-item active" data-name="Slide">
                        <div class="kdvn-hero-slide">
                            <div class="kdvn-hero-text">
                                <p class="kdvn-hero-link-wrap">
                                    <a href="/company-profile" class="btn kdvn-btn-ghost kdvn-hero-link o_translate_inline">View detail <i class="ri-arrow-right-up-line" aria-hidden="true"/></a>
                                </p>
                                <h2 class="kdvn-hero-title">Heart to be the connected in the future</h2>
                            </div>
                            <div class="kdvn-hero-media">
                                <img src="/kdvn_website/static/src/img/content/home-hero-1.jpg" class="img kdvn-hero-img"
                                     alt="Kinden Vietnam team building 2026"/>
                            </div>
                        </div>
                    </div>
                    <div class="carousel-item" data-name="Slide">
                        <div class="kdvn-hero-slide">
                            <div class="kdvn-hero-text">
                                <p class="kdvn-hero-link-wrap">
                                    <a href="/company-profile" class="btn kdvn-btn-ghost kdvn-hero-link o_translate_inline">View detail <i class="ri-arrow-right-up-line" aria-hidden="true"/></a>
                                </p>
                                <h2 class="kdvn-hero-title">Heart to be the connected in the future</h2>
                            </div>
                            <div class="kdvn-hero-media">
                                <img src="/kdvn_website/static/src/img/content/home-hero-2.jpg" class="img kdvn-hero-img"
                                     alt="Kinden Vietnam team" loading="lazy"/>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="kdvn-hero-controls o_not_editable" contenteditable="false">
                    <button type="button" class="carousel-control-prev kdvn-action-btn kdvn-hero-arrow"
                            t-attf-data-bs-target="#kdvnHero{{uniq}}" data-bs-slide="prev" aria-label="Previous" title="Previous">
                        <i class="ri-arrow-left-s-line" aria-hidden="true"/>
                    </button>
                    <button type="button" class="carousel-control-next kdvn-action-btn kdvn-hero-arrow"
                            t-attf-data-bs-target="#kdvnHero{{uniq}}" data-bs-slide="next" aria-label="Next" title="Next">
                        <i class="ri-arrow-right-s-line" aria-hidden="true"/>
                    </button>
                </div>
                <div class="carousel-indicators kdvn-hero-indicators o_not_editable" contenteditable="false">
                    <button type="button" t-attf-data-bs-target="#kdvnHero{{uniq}}" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"/>
                    <button type="button" t-attf-data-bs-target="#kdvnHero{{uniq}}" data-bs-slide-to="1" aria-label="Slide 2"/>
                </div>
            </div>
        </section>
    </template>
</odoo>
