<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Hero slider (Figma: frames/home-desktop|tablet|mobile.png).
        Desktop/tablet: text column 615px (arrows top right, "View detail" + title at the bottom),
        photo fills the rest, 900px high. Mobile: arrows, button, title, then the photo.

        The slides are data (kdvn.website.hero.slide: Website > Site > Content > Hero Slides),
        NOT page content: the template sits outside any oe_structure, so changing a slide never
        makes the website keep a copy of the homepage view. Arrows and indicators sit once,
        outside the slides; the indicators are hidden, built by static/src/js/hero_indicators.js.
        Autoplay: data-bs-ride="carousel" starts on load ("true" waits for the first click).
        Loops: data-bs-wrap="true".
    -->
    <template id="s_kdvn_hero" name="KDVN Hero Slider">
        <t t-set="slides" t-value="request.env['kdvn.website.hero.slide']._kdvn_slides()"/>
        <section t-if="slides" class="s_kdvn_hero p-0">
            <div id="kdvnHero" class="carousel slide kdvn-hero"
                 data-bs-ride="carousel" data-bs-interval="10000" data-bs-wrap="true">
                <div class="carousel-inner">
                    <t t-foreach="slides" t-as="slide">
                        <div t-attf-class="carousel-item #{'active' if slide_first else ''}">
                            <div class="kdvn-hero-slide">
                                <div class="kdvn-hero-text">
                                    <p t-if="slide.link_url" class="kdvn-hero-link-wrap">
                                        <a t-att-href="slide.link_url" class="btn kdvn-btn-ghost kdvn-hero-link">View detail <i class="ri-arrow-right-up-line" aria-hidden="true"/></a>
                                    </p>
                                    <h2 class="kdvn-hero-title" t-out="slide.name"/>
                                </div>
                                <div class="kdvn-hero-media">
                                    <img t-attf-src="/kdvn/hero/#{slide.id}/image?width=1920" class="img kdvn-hero-img"
                                         t-att-alt="slide.name" t-att-loading="None if slide_first else 'lazy'"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </div>

                <div t-if="len(slides) &gt; 1" class="kdvn-hero-controls">
                    <button type="button" class="carousel-control-prev kdvn-action-btn kdvn-hero-arrow"
                            data-bs-target="#kdvnHero" data-bs-slide="prev" aria-label="Previous" title="Previous">
                        <i class="ri-arrow-left-s-line" aria-hidden="true"/>
                    </button>
                    <button type="button" class="carousel-control-next kdvn-action-btn kdvn-hero-arrow"
                            data-bs-target="#kdvnHero" data-bs-slide="next" aria-label="Next" title="Next">
                        <i class="ri-arrow-right-s-line" aria-hidden="true"/>
                    </button>
                </div>
                <div class="carousel-indicators kdvn-hero-indicators"/>
            </div>
        </section>
    </template>
</odoo>
