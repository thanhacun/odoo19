<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="kdvn_custom_header" inherit_id="website.layout" name="KDVN Production Header Blueprint">
        <xpath expr="//header" position="replace">
            <!-- Full-width structural background layer -->
            <header id="top" data-anchor="true" 
                    class="navbar navbar-expand-xl sticky-top oe_unremovable p-0 m-0 kdvn-header o_no_autohide_menu">
                
                <!-- FIGMA MAIN CONTENT SECTION WRAPPER: Handles your horizontal/vertical padding precisely -->
                <div class="d-flex flex-wrap align-items-center justify-content-between w-100 mx-auto kdvn-navbar-main-content">
                    
                    <!-- 1. Logo Segment Component -->
                    <a href="/" class="navbar-brand d-flex align-items-center m-0 p-0">
                        <img src="/kdvn_website/static/src/img/content/kinden-logo.png" 
                             alt="Kinden Vietnam"
                             class="m-0 p-0 kdvn-header-logo"
                             loading="eager"/>
                    </a>

                    <!-- Mobile Toggler Option -->
                    <button class="navbar-toggler kdvn-menu-toggle" type="button"
                            data-bs-toggle="collapse" data-bs-target="#kdvnTopHeaderNav"
                            aria-controls="kdvnTopHeaderNav" aria-expanded="false" aria-label="Toggle navigation">
                        <i class="ri-menu-line" aria-hidden="true"/>
                    </button>

                    <!-- Responsive Collapse Wrapper -->
                    <div class="collapse navbar-collapse kdvn-navbar-collapse-wrapper" id="kdvnTopHeaderNav">
                        
                        <!-- 2. MAIN MENU BLOCK (Centered across the navigation track) -->
                        <!-- top_menu + o_no_autohide_menu on the header: Odoo's auto-hide menu script expects a .top_menu and stops there -->
                        <ul class="navbar-nav align-items-xl-center gap-2 mb-3 mb-xl-0 kdvn-centered-menu-group top_menu" t-if="website.menu_id">
                            <t t-foreach="website.menu_id.child_id" t-as="submenu">
                                
                                <!-- Standard Menu Item Anchor Target Link -->
                                <li t-if="not submenu.child_id" class="nav-item m-0 p-0">
                                    <a t-att-href="submenu.url" 
                                       t-attf-class="nav-link kdvn-nav-link px-2 py-2 #{'active' if request.httprequest.path == submenu.url else ''}">
                                        <span t-field="submenu.name"/>
                                    </a>
                                </li>
                                
                                <!-- Dropdown menu: hover = underline, click = open mega panel (Figma prototype) -->
                                <li t-else="" class="nav-item dropdown position-static m-0 p-0 kdvn-mega-dropdown">
                                    <a class="nav-link dropdown-toggle kdvn-nav-link px-2 py-2"
                                       href="#" t-att-id="'menu_%s' % submenu.id" role="button"
                                       data-bs-toggle="dropdown" data-bs-display="static" aria-expanded="false">
                                        <span t-field="submenu.name"/>
                                    </a>

                                    <div class="dropdown-menu kdvn-mega-menu-panel" t-att-aria-labelledby="'menu_%s' % submenu.id">
                                        <div class="kdvn-mega-menu-inner">
                                            <!-- Left: section title, optional description, View details -->
                                            <div class="kdvn-mega-menu-intro">
                                                <h3 class="kdvn-mega-menu-title" t-field="submenu.name"/>
                                                <p t-if="submenu.description" class="kdvn-mega-menu-description" t-field="submenu.description"/>
                                                <a t-if="submenu.overview_url" t-att-href="submenu.overview_url" class="btn kdvn-btn-ghost">View details</a>
                                            </div>
                                            <!-- Right: links, max 5 per column -->
                                            <ul class="list-unstyled m-0 kdvn-mega-menu-links">
                                                <li t-foreach="submenu.child_id" t-as="childmenu">
                                                    <a t-att-href="childmenu.url" class="kdvn-mega-menu-link"
                                                       t-att-target="'_blank' if childmenu.new_window else None">
                                                        <span t-field="childmenu.name"/>
                                                    </a>
                                                </li>
                                            </ul>
                                        </div>
                                    </div>
                                </li>
                            </t>
                        </ul>

                        <!-- 3. Corporate Action Items Segment Component -->
                        <div class="d-flex align-items-center gap-3 ms-xl-auto mt-1 mt-xl-0 o_not_editable kdvn-actions-right-block" contenteditable="false">
                            <button type="button" class="btn kdvn-action-btn" data-kdvn-open="kdvn_search_panel"
                                    aria-haspopup="dialog" aria-controls="kdvn_search_panel" title="Search" aria-label="Search">
                                <i class="ri-search-line" aria-hidden="true"/>
                            </button>
                            <button type="button" class="btn kdvn-action-btn" data-kdvn-open="kdvn_lang_panel"
                                    aria-haspopup="dialog" aria-controls="kdvn_lang_panel" title="Language" aria-label="Language">
                                <i class="ri-global-line" aria-hidden="true"/>
                            </button>
                        </div>

                    </div>
                </div>
            </header>
        </xpath>

        <!-- Search and Language panels (frames/search-*.png, languages-*.png):
             desktop/tablet = centred box, mobile = full screen with a back arrow.
             Opened by the header buttons (static/src/js/panels.js). -->
        <xpath expr="//header" position="after">
            <div class="kdvn-modal kdvn-panel o_not_editable" id="kdvn_search_panel" role="dialog" aria-modal="true"
                 aria-labelledby="kdvn_search_title" hidden="hidden">
                <div class="kdvn-modal-backdrop" data-kdvn-close=""/>
                <div class="kdvn-modal-dialog">
                    <div class="kdvn-modal-head">
                        <button type="button" class="kdvn-panel-back" data-kdvn-close="" aria-label="Back"><i class="ri-arrow-left-s-line" aria-hidden="true"/></button>
                        <h2 class="kdvn-modal-title" id="kdvn_search_title">Search</h2>
                        <button type="button" class="kdvn-modal-x" data-kdvn-close="" aria-label="Close"><i class="ri-close-line" aria-hidden="true"/></button>
                    </div>
                    <form t-att-action="url_for('/website/search')" method="get" role="search" class="kdvn-search-form">
                        <label class="visually-hidden" for="kdvn_search_input">Search</label>
                        <input type="search" name="search" id="kdvn_search_input" class="kdvn-input kdvn-search-input"
                               placeholder="Search name, categories,..." autocomplete="off" required="required"/>
                    </form>
                </div>
            </div>
            <div class="kdvn-modal kdvn-panel o_not_editable" id="kdvn_lang_panel" role="dialog" aria-modal="true"
                 aria-labelledby="kdvn_lang_title" hidden="hidden">
                <div class="kdvn-modal-backdrop" data-kdvn-close=""/>
                <div class="kdvn-modal-dialog">
                    <div class="kdvn-modal-head">
                        <button type="button" class="kdvn-panel-back" data-kdvn-close="" aria-label="Back"><i class="ri-arrow-left-s-line" aria-hidden="true"/></button>
                        <h2 class="kdvn-modal-title" id="kdvn_lang_title">Language</h2>
                        <button type="button" class="kdvn-modal-x" data-kdvn-close="" aria-label="Close"><i class="ri-close-line" aria-hidden="true"/></button>
                    </div>
                    <ul class="kdvn-lang-list list-unstyled">
                        <li t-foreach="website._kdvn_language_choices()" t-as="choice"
                            t-att-class="'is-active' if request.lang and choice[0].code == request.lang.code else None">
                            <t t-set="lg" t-value="choice[0]"/>
                            <a t-att-href="url_localized(lang_code=lg.code)" t-att-data-url_code="lg.url_code"
                               t-att-hreflang="(lg.iso_code or lg.code).replace('_', '-')" t-att-lang="(lg.iso_code or lg.code).replace('_', '-')"
                               t-att-aria-current="'true' if request.lang and lg.code == request.lang.code else None"
                               class="kdvn-lang js_change_lang"
                               t-out="choice[1]"/>
                        </li>
                    </ul>
                </div>
            </div>
        </xpath>
    </template>
</odoo>
