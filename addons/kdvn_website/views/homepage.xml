<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Homepage (Figma: frames/home-*.png; spec: design/kdvn_website/specs/home.md).
        Editable areas (oe_structure) for text and the hero slider; data blocks (t-call)
        stay outside them so saving in the builder never freezes them.
        When an editor saves the homepage, Odoo stores each edited oe_structure (by id) as
        a small website-specific view, and keeps a website copy of this outline with that
        area emptied: from then on, changes to this file's outline (and to the default
        content of edited areas) no longer reach that website. Data blocks (t-call
        templates), styles and new inheriting views (e.g. kdvn_website_project's projects
        section) still apply. So: put homepage changes in new sections / templates.
    -->
    <template id="kdvn_homepage_blueprint" inherit_id="website.homepage" name="KDVN Homepage">
        <xpath expr="//div[@id='wrap']" position="replace">
            <div id="wrap" class="kdvn-home">
                <h1 class="visually-hidden">Kinden Vietnam</h1>

                <!-- 1. Hero slider -->
                <div id="oe_structure_kdvn_home_hero" class="oe_structure">
                    <t t-call="kdvn_website.s_kdvn_hero"/>
                </div>

                <!-- 2. Business Information -->
                <section class="kdvn-home-business">
                    <div class="kdvn-container">
                        <div id="oe_structure_kdvn_home_business" class="oe_structure">
                            <section class="s_text_block kdvn-home-head" data-snippet="s_text_block" data-name="Section title">
                                <h2 class="kdvn-home-title">Business Information</h2>
                                <p class="kdvn-home-lead">Kinden supports peoples&#8217; livelihoods in the fields of energy, environment and information.</p>
                            </section>
                        </div>
                        <t t-call="kdvn_website.home_business_list"/>
                    </div>
                </section>

                <!-- 3. Past Prominent Projects: next round -->
                <div id="oe_structure_kdvn_home_bottom" class="oe_structure"/>
            </div>
        </xpath>
    </template>
</odoo>
