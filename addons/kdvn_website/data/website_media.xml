    <data noupdate="1">
        <record id="media_general_director_photo" model="kdvn.website.media">
            <field name="name">General Director Message - photo</field>
            <field name="key">general_director_photo</field>
            <field name="sequence">10</field>
            <field name="note">Board of Directors group photo. Landscape works best (about 1536 x 1024).</field>
            <field name="image" type="base64" file="kdvn_website/static/src/img/content/general-director-bod.jpg"/>
        </record>
        <record id="media_company_history_intro" model="kdvn.website.media">
            <field name="name">Company History - intro photo</field>
            <field name="key">company_history_intro</field>
            <field name="sequence">20</field>
            <field name="note">Shown centred, up to 620 px wide. The caption is page text (translatable), not part of the image.</field>
            <field name="image" type="base64" file="kdvn_website/static/src/img/content/company-history-first-president.jpg"/>
        </record>
        <record id="media_logo_white" model="kdvn.website.media">
