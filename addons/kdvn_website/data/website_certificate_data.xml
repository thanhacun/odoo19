<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Daily "Renew" to-dos for certificates close to their expiry date -->
    <record id="ir_cron_certificate_renewal" model="ir.cron">
        <field name="name">Website: certificate renewal reminders</field>
        <field name="model_id" ref="model_kdvn_website_certificate"/>
        <field name="state">code</field>
        <field name="code">model._cron_renewal_reminders()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>

    <!-- Starting certificates, read from the design frames (licences-certificates-*.png).
         The images are cut from the frames (low resolution): replace them with the
         original scans. noupdate: changes made in the backend are kept. -->
