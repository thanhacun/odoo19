<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ======================================================================== -->
    <!-- AUTOMATED SYSTEM MENUS CLEANUP                                           -->
    <!-- ======================================================================== -->
    <!-- Clear default system menu: Home -->
    <delete model="website.menu" search="[('url', '=', '/'), ('website_id', '=', ref('website.default_website'))]"/>
    <!-- Clear default system menu: Contact us -->
    <delete model="website.menu" search="[('url', '=', '/contactus'), ('website_id', '=', ref('website.default_website'))]"/>

    <!-- ======================================================================== -->
    <!-- CUSTOM DESIGN NAVIGATION MATRIX                                          -->
    <!-- ======================================================================== -->
    <!-- noupdate="0" during development: every module update resets the menus to
         menus.csv (menu edits made in the website are overwritten).
         Switch to noupdate="1" before go-live so editors' menu changes are kept. -->
    <data noupdate="0">
        <!-- Menu: KDVN Menu Root -->
        <record id="menu_kdvn_master_root" model="website.menu">
            <field name="name">KDVN Menu Root</field>
            <field name="url">/default-main-menu</field>
            <field name="website_id" ref="website.default_website"/>
            <field name="sequence" type="int">1</field>
        </record>

