        <record id="menu_kdvn_company_profile" model="website.menu">
            <field name="name">Company profile</field>
            <field name="url">#</field>
            <field name="website_id" ref="website.default_website"/>
            <field name="is_mega_menu">False</field>
            <field name="parent_id" ref="kdvn_website.menu_kdvn_master_root"/>
            <field name="sequence" type="int">10</field>
            <field name="overview_url">/company-profile</field>
        </record>

